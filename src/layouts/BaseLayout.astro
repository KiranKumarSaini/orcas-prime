---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteWhatsAppFloat from '../components/SiteWhatsAppFloat.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import Schema from '../components/Schema.astro';
import { organization, localBusiness } from '../lib/schema';
import { SITE } from '../lib/site';

export interface Props {
  /** Page title. Appended with " — Orcas Prime" unless titleTemplate is 'none'. */
  title: string;
  /** Meta description. First 160 chars are the SERP snippet — write for extraction. */
  description: string;
  /** Absolute or /-prefixed path to the OG image. Defaults to the sitewide fallback. */
  ogImage?: string;
  /** Canonical path (path only, e.g. "/pricing"). Defaults to the current URL. */
  canonicalPath?: string;
  /** Skip title suffix. Use for the homepage where the wordmark carries it. */
  titleTemplate?: 'default' | 'none';
  /** Prevent indexing (utility pages, styleguide, etc.). */
  noindex?: boolean;
  /** Pre-filled WhatsApp message for the mobile sticky CTA. Defaults to the general one. */
  stickyMessage?: string;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  canonicalPath,
  titleTemplate = 'default',
  noindex = false,
  stickyMessage = 'Hi, I want to check if the 3.5% model fits my store.',
} = Astro.props;

const fullTitle = titleTemplate === 'none' ? title : `${title} — ${SITE.name}`;

// Astro.site is set in astro.config.mjs (placeholder domain until deploy).
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = siteOrigin + (canonicalPath ?? Astro.url.pathname);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : siteOrigin + ogImage;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#FAF7F2" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		{/* Sitewide identity — Organization + LocalBusiness on every page (§7 Layer 3). */}
		<Schema data={[organization(), localBusiness()]} />

		{/* Per-page schema slot (Service, FAQPage, BreadcrumbList, Person, etc.). */}
		<slot name="head" />
	</head>
	{/* pb-24 on mobile reserves room for StickyMobileCTA so it can never cover
	    content (Module 9 §5) — the bar is now an inset floating pill rather
	    than a flush bottom bar, so it needs its own height plus its bottom
	    inset plus the safe area, not just its height. Desktop has no sticky
	    bar, so no padding. */}
	{/* bg-page, not bg-paper: the page sits DARKER than the panels so each
	    section reads as a separate object on it. A bg-paper utility here was
	    silently overriding the base rule and flattening the whole effect. */}
	<body class="bg-page text-ink min-h-screen flex flex-col pb-24 md:pb-0">
		<a href="#main" class="skip-link">Skip to content</a>
		<ScrollProgress />
		<SiteHeader />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<SiteFooter />
		<SiteWhatsAppFloat />
		<StickyMobileCTA message={stickyMessage} />

		{/* Magnetic CTAs (Module 10 §5). Pointer-fine only — on touch there is
		    no hover, so the effect would either never fire or fire and stick.
		    Movement is capped at 4px: the point is that the button feels
		    responsive under the cursor, not that it visibly slides around. */}
		<script>
			import { prefersReducedMotion, hasFinePointer } from '../lib/motion';

			if (hasFinePointer() && !prefersReducedMotion()) {
				const MAX = 4;
				const targets = document.querySelectorAll<HTMLElement>('[data-cta], .magnetic');

				targets.forEach((el) => {
					el.classList.add('magnetic');

					el.addEventListener('pointermove', (e) => {
						const r = el.getBoundingClientRect();
						const dx = (e.clientX - (r.left + r.width / 2)) / (r.width / 2);
						const dy = (e.clientY - (r.top + r.height / 2)) / (r.height / 2);
						el.style.transform =
							`translate(${Math.max(-1, Math.min(1, dx)) * MAX}px, ${Math.max(-1, Math.min(1, dy)) * MAX}px)`;
					});

					// Always reset on leave — a stuck offset is worse than no effect.
					const reset = () => { el.style.transform = ''; };
					el.addEventListener('pointerleave', reset);
					el.addEventListener('blur', reset);
				});
			}
		</script>

		{/* Entrance animation, Phase 1 (Module 4 §6). Progressive enhancement —
		    .js-ready is only added once this script runs, so [data-animate]
		    content stays fully visible with JS disabled (global.css). Fires
		    once per element, never re-animates on scroll-back.

		    Real bug found 2026-08-09: IntersectionObserver callbacks fire
		    asynchronously, one or more frames after the initial opacity:0
		    paint — never visible to a human (the gap is milliseconds), but a
		    tool that renders the page and immediately samples computed style
		    (Lighthouse's accessibility pass, some AI-crawler renderers) can
		    catch content genuinely mid-fade and report it as a real contrast
		    failure, because the colour it read really was that faint at that
		    instant. Confirmed via Lighthouse: elements already on screen at
		    load were being sampled at ~20% opacity.

		    Fix: content already inside the viewport at load is shown at full
		    opacity synchronously, in this same script tick, before the first
		    paint — there is nothing to fade in, because it was never below
		    the fold to begin with. Only content revealed by an actual later
		    scroll goes through the observer + transition path. This doesn't
		    change how anything looks to a visitor; it removes a sampling
		    window that only automated tools could ever land in.

		    Safety net: a target the observer never resolves (backgrounded tab,
		    a target taller than the viewport that never crosses threshold, any
		    other edge case) must not stay invisible forever — Module 4 §6 is
		    explicit that content must never ship blank. Shortened from 2s to
		    400ms — real observers resolve in milliseconds; 2s was a large,
		    arbitrary margin that widened this exact sampling window rather
		    than protecting against anything that actually takes that long. */}
		<script>
			document.documentElement.classList.add('js-ready');

			// Both forms are observed: [data-animate] fades a whole block,
			// [data-animate-group] fades its [data-animate-item] children in
			// sequence (Module 9 §6). Missing the group selector here leaves
			// every staggered child at opacity 0 permanently — the exact
			// content-loss failure the fallback below exists to prevent, so
			// the two selectors must stay in sync.
			const targets = document.querySelectorAll('[data-animate], [data-animate-group]');
			if ('IntersectionObserver' in window && targets.length) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								io.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.15 }
				);
				targets.forEach((el) => {
					const rect = el.getBoundingClientRect();
					const inViewportNow = rect.top < window.innerHeight && rect.bottom > 0;
					if (inViewportNow) {
						el.classList.add('is-visible');
					} else {
						io.observe(el);
					}
				});

				setTimeout(() => {
					targets.forEach((el) => el.classList.add('is-visible'));
					io.disconnect();
				}, 400);
			} else {
				targets.forEach((el) => el.classList.add('is-visible'));
			}
		</script>
	</body>
</html>
