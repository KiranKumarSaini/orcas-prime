---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteWhatsAppFloat from '../components/SiteWhatsAppFloat.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import Schema from '../components/Schema.astro';
import { organization, localBusiness } from '../lib/schema';
import { SITE } from '../lib/site';

export interface Props {
  /** Page title. Appended with " — Orcas Prime" unless titleTemplate is 'none'. */
  title: string;
  /** Meta description. First 160 chars are the SERP snippet — write for extraction. */
  description: string;
  /** Absolute or /-prefixed path to the OG image. Defaults to the sitewide fallback. */
  ogImage?: string;
  /** Canonical path (path only, e.g. "/pricing"). Defaults to the current URL. */
  canonicalPath?: string;
  /** Skip title suffix. Use for the homepage where the wordmark carries it. */
  titleTemplate?: 'default' | 'none';
  /** Prevent indexing (utility pages, styleguide, etc.). */
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  canonicalPath,
  titleTemplate = 'default',
  noindex = false,
} = Astro.props;

const fullTitle = titleTemplate === 'none' ? title : `${title} — ${SITE.name}`;

// Astro.site is set in astro.config.mjs (placeholder domain until deploy).
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = siteOrigin + (canonicalPath ?? Astro.url.pathname);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : siteOrigin + ogImage;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#FAF7F2" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		{/* Sitewide identity — Organization + LocalBusiness on every page (§7 Layer 3). */}
		<Schema data={[organization(), localBusiness()]} />

		{/* Per-page schema slot (Service, FAQPage, BreadcrumbList, Person, etc.). */}
		<slot name="head" />
	</head>
	{/* pb-14 on mobile reserves room for StickyMobileCTA so it can never cover
	    content (Module 9 §5). Desktop has no sticky bar, so no padding. */}
	{/* bg-page, not bg-paper: the page sits DARKER than the panels so each
	    section reads as a separate object on it. A bg-paper utility here was
	    silently overriding the base rule and flattening the whole effect. */}
	<body class="bg-page text-ink min-h-screen flex flex-col pb-14 md:pb-0">
		<a href="#main" class="skip-link">Skip to content</a>
		<ScrollProgress />
		<SiteHeader />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<SiteFooter />
		<SiteWhatsAppFloat />

		{/* Entrance animation, Phase 1 (Module 4 §6). Progressive enhancement —
		    .js-ready is only added once this script runs, so [data-animate]
		    content stays fully visible with JS disabled (global.css). Fires
		    once per element, never re-animates on scroll-back.

		    Safety net: a target the observer never resolves (backgrounded tab,
		    a target taller than the viewport that never crosses threshold, any
		    other edge case) must not stay invisible forever — Module 4 §6 is
		    explicit that content must never ship blank. Anything still hidden
		    2s after its section has had a chance to load is forced visible. */}
		<script>
			document.documentElement.classList.add('js-ready');

			// Both forms are observed: [data-animate] fades a whole block,
			// [data-animate-group] fades its [data-animate-item] children in
			// sequence (Module 9 §6). Missing the group selector here leaves
			// every staggered child at opacity 0 permanently — the exact
			// content-loss failure the fallback below exists to prevent, so
			// the two selectors must stay in sync.
			const targets = document.querySelectorAll('[data-animate], [data-animate-group]');
			if ('IntersectionObserver' in window && targets.length) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								io.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.15 }
				);
				targets.forEach((el) => io.observe(el));

				setTimeout(() => {
					targets.forEach((el) => el.classList.add('is-visible'));
					io.disconnect();
				}, 2000);
			} else {
				targets.forEach((el) => el.classList.add('is-visible'));
			}
		</script>
	</body>
</html>
