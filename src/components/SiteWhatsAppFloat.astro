---
/**
 * Permanent, quiet WhatsApp button. §9 rules:
 *   - Always present, always same position.
 *   - Never animates.
 *   - Never demands attention.
 *
 * Fixed bottom-right, small accent pill on desktop, circle on mobile so it
 * doesn't crowd tap targets. Safe-area padding respects notches.
 */

import { SITE } from '../lib/site';

const digits = SITE.contact.whatsapp.replace(/[^0-9]/g, '');
const message = 'Hi, I want to check if the 3.5% model fits my store.';
const href = `https://wa.me/${digits}?text=${encodeURIComponent(message)}`;
---

<a
	href={href}
	rel="noopener"
	aria-label="Message us on WhatsApp"
	data-cta="whatsapp-float"
	class="fixed z-40 right-4 sm:right-6 bottom-[calc(env(safe-area-inset-bottom,0px)+1rem)] sm:bottom-6
	       inline-flex items-center gap-2
	       bg-accent text-paper hover:bg-accent-hover
	       rounded-full shadow-sm
	       transition-colors
	       h-12 w-12 sm:w-auto sm:h-auto sm:px-4 sm:py-2.5
	       justify-center"
>
	<svg
		aria-hidden="true"
		width="20"
		height="20"
		viewBox="0 0 24 24"
		fill="currentColor"
	>
		<path d="M20.52 3.48A11.87 11.87 0 0 0 12.05 0C5.5 0 .13 5.37.13 11.92c0 2.1.55 4.15 1.6 5.96L0 24l6.3-1.65a11.9 11.9 0 0 0 5.7 1.45h.01c6.55 0 11.92-5.37 11.92-11.92 0-3.18-1.24-6.17-3.4-8.4Zm-8.47 18.34h-.01a9.9 9.9 0 0 1-5.05-1.38l-.36-.22-3.74.98 1-3.64-.24-.37a9.87 9.87 0 0 1-1.52-5.27c0-5.46 4.45-9.9 9.92-9.9 2.65 0 5.14 1.03 7.01 2.9a9.85 9.85 0 0 1 2.9 7 9.9 9.9 0 0 1-9.9 9.9Zm5.44-7.42c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.66.15-.2.3-.76.97-.93 1.17-.17.2-.34.22-.64.07-.3-.15-1.26-.46-2.4-1.48a9.03 9.03 0 0 1-1.67-2.07c-.17-.3-.02-.46.13-.61.13-.13.3-.34.45-.51.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.66-1.6-.91-2.19-.24-.58-.48-.5-.66-.51l-.56-.01c-.2 0-.52.07-.79.37-.27.3-1.03 1-1.03 2.45 0 1.45 1.05 2.85 1.2 3.05.15.2 2.07 3.16 5 4.43.7.3 1.24.48 1.67.62.7.22 1.34.19 1.84.11.56-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35Z"/>
	</svg>
	<span class="hidden sm:inline font-sans text-small font-medium">Message us</span>
</a>
