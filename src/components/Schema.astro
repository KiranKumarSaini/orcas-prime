---
/**
 * Emits one or more JSON-LD blocks in <head>. Use with the builders in
 * src/lib/schema.ts — pages compose their schema shape there, then pass it
 * to this component via the layout's `head` slot.
 *
 *   <Schema data={organization()} />
 *   <Schema data={[breadcrumb([...]), faqPage([...])]} />
 *
 * We deliberately emit one <script> per top-level object rather than a single
 * @graph array — some validators and AI crawlers still index better against
 * flat multiple scripts.
 */

export interface Props {
  data: object | object[];
}

const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
---

{
  items.map((item) => (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(item)}
    />
  ))
}
