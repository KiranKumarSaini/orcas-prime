---
/*
  Floating pill header (2026-08-09, replacing the full-width sticky bar from
  Module 9 §5).

  The site's core layout unit is already a rounded panel floating on the
  darker --color-page background — every section does this. The header was
  the one piece of chrome that didn't: a square-cornered bar flush to the
  viewport edges. Making it a pill, inset from the top and sides, makes it
  read as the same kind of floating object as everything below it instead
  of a separate UI convention layered on top.

  Still --paper at 95% opacity with backdrop-filter blur — the one permitted
  blur, because it's functional (keeps nav legible over whatever scrolls
  underneath). A hairline border defines the pill's edge at rest; a shadow
  strengthens only once the page has scrolled, so it lifts off the content
  behind it rather than looking elevated from the very first frame.

  Nav labels per Module 3 Global Elements: Services -> What We Own
  (LOCKED#17; label only, URL stays /services per Module 7 §11). Desktop
  gains the primary CTA — on a long page the ask should never be more than
  one scroll-to-top away.
*/

import { SITE } from '../lib/site';

const nav = [
  { href: '/services', label: 'What We Own' },
  { href: '/work',     label: 'Work' },
  { href: '/pricing',  label: 'Pricing' },
  { href: '/guides',   label: 'Learn' },
  { href: '/about',    label: 'About' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const digits = SITE.contact.whatsapp.replace(/[^0-9]/g, '');
const ctaHref = `https://wa.me/${digits}?text=${encodeURIComponent(
  'Hi, I want to check if the 3.5% model fits my store.'
)}`;
---

<div class="sticky top-3 md:top-4 z-30 px-3 md:px-6">
	<div class="max-w-[76rem] mx-auto">
		<header
			id="sv-header"
			class="bg-paper/95 backdrop-blur-md border border-rule rounded-full shadow-[0_1px_2px_rgba(20,18,15,0.05)] transition-shadow duration-200"
		>
			<div class="px-5 md:px-7 h-14 md:h-16 flex items-center justify-between gap-6">
				<a href="/" class="font-serif text-lg md:text-xl tracking-tight text-ink hover:text-accent transition-colors">
					Orcas Prime
				</a>

				<nav aria-label="Primary" class="hidden md:block">
					<ul class="flex items-center gap-7">
						{nav.map((item) => {
							const active = currentPath === item.href;
							return (
								<li>
									<a
										href={item.href}
										aria-current={active ? 'page' : undefined}
										class:list={[
											'font-sans text-small transition-colors',
											active ? 'text-accent' : 'text-ink hover:text-accent',
										]}
									>
										{item.label}
									</a>
								</li>
							);
						})}
					</ul>
				</nav>

				<a
					href={ctaHref}
					rel="noopener"
					data-cta="whatsapp"
					class="hidden md:inline-flex items-center gap-1.5 bg-accent text-paper hover:bg-accent-hover px-4 py-2 rounded-full font-sans text-small font-medium transition-colors"
				>
					Start on WhatsApp
					<span aria-hidden="true" class="arrow-travel">&rarr;</span>
				</a>

				<button
					id="sv-menu-btn"
					type="button"
					class="md:hidden inline-flex items-center gap-2 text-ink font-sans text-small min-h-[44px]"
					aria-controls="sv-mobile-nav"
					aria-expanded="false"
				>
					<span class="sv-menu-word" data-when="closed">Menu</span>
					<span class="sv-menu-word hidden" data-when="open">Close</span>
					<svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5">
						<line class="sv-menu-line sv-menu-line-top" x1="2" y1="5" x2="16" y2="5" />
						<line class="sv-menu-line sv-menu-line-bottom" x1="2" y1="13" x2="16" y2="13" />
					</svg>
				</button>
			</div>
		</header>

		<div id="sv-mobile-nav" hidden class="sv-nav-panel md:hidden mt-2 bg-paper border border-rule rounded-2xl shadow-[0_1px_2px_rgba(20,18,15,0.05)] overflow-hidden">
			<nav aria-label="Primary mobile" class="px-6 py-2">
				<ul class="flex flex-col divide-y divide-rule">
					{nav.map((item) => {
						const active = currentPath === item.href;
						return (
							<li>
								<a
									href={item.href}
									aria-current={active ? 'page' : undefined}
									class:list={[
										'block py-4 font-sans text-base',
										active ? 'text-accent' : 'text-ink',
									]}
								>
									{item.label}
								</a>
							</li>
						);
					})}
				</ul>
			</nav>
		</div>
	</div>
</div>

<script>
	// Mobile menu toggle. The hamburger morphs into an X via the CSS below,
	// keyed off aria-expanded — no extra class needed. The panel plays a
	// pop-in keyframe animation the instant `hidden` is removed (animations
	// restart on display:none -> displayed, unlike transitions, which is why
	// this uses @keyframes rather than a transition). Closing plays the
	// reverse animation first and only re-adds `hidden` once it finishes, so
	// the panel never just vanishes.
	//
	// Safety net: `animationend` is not guaranteed to fire (verified — a
	// backgrounded or throttled tab can drop it entirely), and if it never
	// fires the menu would stay stuck open with `hidden` never restored.
	// A timeout slightly longer than the animation closes it regardless;
	// whichever path runs first wins and the other is a no-op.
	const btn = document.getElementById('sv-menu-btn');
	const panel = document.getElementById('sv-mobile-nav');
	if (btn && panel) {
		btn.addEventListener('click', () => {
			const open = btn.getAttribute('aria-expanded') === 'true';
			const next = !open;
			btn.setAttribute('aria-expanded', String(next));
			btn.querySelectorAll<HTMLElement>('[data-when]').forEach((el) => {
				el.classList.toggle('hidden', (el.dataset.when === 'open') !== next);
			});

			if (next) {
				panel.classList.remove('sv-nav-closing');
				panel.removeAttribute('hidden');
			} else {
				panel.classList.add('sv-nav-closing');
				let done = false;
				const finish = () => {
					if (done) return;
					done = true;
					panel.setAttribute('hidden', '');
					panel.classList.remove('sv-nav-closing');
					panel.removeEventListener('animationend', finish);
				};
				panel.addEventListener('animationend', finish);
				window.setTimeout(finish, 260);
			}
		});
	}

	// The pill's shadow strengthens only once the page has moved — at rest it
	// should read as sitting on the page, not lifted above it from frame one.
	const header = document.getElementById('sv-header');
	if (header) {
		let ticking = false;
		const sync = () => {
			header.classList.toggle('sv-header-scrolled', window.scrollY > 8);
			ticking = false;
		};
		sync();
		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(sync);
				}
			},
			{ passive: true }
		);
	}
</script>

<style>
	/* Stronger lift once the page has moved — the pill separates from the
	   content now visible behind it instead of looking elevated at rest. */
	#sv-header.sv-header-scrolled {
		box-shadow: 0 4px 16px rgba(20, 18, 15, 0.08);
	}

	/* Hamburger -> X. Each line moves to the icon's centre, then rotates —
	   translate first, rotate second, so the two lines cross exactly at
	   (9,9) instead of sweeping past each other. */
	.sv-menu-line {
		transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.sv-menu-line-top { transform-origin: 9px 5px; }
	.sv-menu-line-bottom { transform-origin: 9px 13px; }
	#sv-menu-btn[aria-expanded='true'] .sv-menu-line-top {
		transform: translateY(4px) rotate(45deg);
	}
	#sv-menu-btn[aria-expanded='true'] .sv-menu-line-bottom {
		transform: translateY(-4px) rotate(-45deg);
	}

	/* Mobile nav panel pop-in/out, dropping from the pill it hangs below. */
	@keyframes sv-nav-in {
		from { opacity: 0; transform: translateY(-8px) scale(0.98); }
		to   { opacity: 1; transform: translateY(0) scale(1); }
	}
	@keyframes sv-nav-out {
		from { opacity: 1; transform: translateY(0) scale(1); }
		to   { opacity: 0; transform: translateY(-8px) scale(0.98); }
	}
	.sv-nav-panel {
		transform-origin: top center;
		animation: sv-nav-in 240ms cubic-bezier(0.16, 1, 0.3, 1) both;
	}
	.sv-nav-panel.sv-nav-closing {
		animation: sv-nav-out 180ms cubic-bezier(0.4, 0, 1, 1) both;
	}
</style>
