---
/**
 * Small uppercase label that opens a section. Module 4 §7 spec — reuses the
 * existing `.kicker` global class (mono, micro, tracked, --ink-muted) rather
 * than introducing a parallel token set for the same thing.
 *
 * `n` prints an editorial section numeral (Module 10 §5). It gives the page a
 * spine — a reader can tell where they are in a long scroll without a
 * progress bar — and costs nothing. Decorative-only, so aria-hidden: the
 * numeral is not information a screen reader needs read aloud before every
 * heading.
 */
export interface Props {
  /** Section number, e.g. 3 renders as "03 /". Omit for unnumbered eyebrows. */
  n?: number;
  class?: string;
}
const { n, class: extraClass = '' } = Astro.props;
---
<p class:list={['kicker', extraClass]}>
	{n !== undefined && (
		<>
			<span aria-hidden="true" class="text-accent">{String(n).padStart(2, '0')}</span>
			<span aria-hidden="true" class="opacity-40 mx-2">/</span>
		</>
	)}
	<slot />
</p>
