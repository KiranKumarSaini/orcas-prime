---
/*
  Footer is where the "two founders in Jaipur" story lives (§3 — deliberately
  kept out of the hero). Also the visual anchor whose schema counterpart lives
  in the sitewide LocalBusiness JSON-LD emitted from BaseLayout.

  All identity/contact/address data comes from src/lib/site.ts — the single
  source of truth. TODOs live there; do not duplicate them here.
*/

import { SITE } from '../lib/site';

const founders = SITE.founders.map((f) => f.name);

/*
  Address is assembled from the parts that are actually known. Street and PIN
  are empty until the operator supplies them, and joining on non-empty parts
  means the line can never render a dangling comma or a bare region — it
  degrades to "Jaipur, Rajasthan, India", which is true, rather than to the
  placeholder text that used to ship here.
*/
const addressLine = [
  SITE.address.street,
  SITE.address.locality,
  [SITE.address.region, SITE.address.postalCode].filter(Boolean).join(' '),
  'India',
]
  .filter(Boolean)
  .join(', ');

const contact = {
  whatsapp: SITE.contact.whatsapp,
  phone: SITE.contact.phone,
  email: SITE.contact.email,
};

const footerNav = {
  /*
    The hub link lives on the column heading itself (below), not as a row here.
    A row labelled 'Services' both duplicated the heading and broke LOCKED#17,
    which fixes the visible label as "What We Own" everywhere — only the URL
    stays /services.
  */
  work: [
    { href: '/services/shopify-meta-google-ads',     label: 'Shopify + ads' },
    { href: '/services/amazon-account-management',   label: 'Amazon management' },
    { href: '/services/flipkart-meesho-management',  label: 'Flipkart & Meesho' },
    { href: '/services/creative-and-catalogue',      label: 'Creative & catalogue' },
  ],
  proof: [
    { href: '/pricing',     label: 'Pricing' },
    { href: '/work',        label: 'Case studies' },
    { href: '/about',       label: 'About' },
    { href: '/how-we-work', label: 'How we work' },
    { href: '/guides',      label: 'Guides' },
  ],
  start: [
    { href: '/amazon-free-onboarding', label: 'Free 3 months on Amazon' },
    { href: '/contact',                label: 'Contact' },
  ],
};

const year = new Date().getFullYear();
---

{/*
  The footer is a floating panel like every other section, not a flat
  full-bleed slab. It was the last surface still using the pre-2026-08-08
  layout language (square corners, edge-to-edge, hairline top border), which
  made the page end on a different visual system than it ran on.
*/}
<footer class="bg-paper panel mt-6 md:mt-8 mb-3 md:mb-4">
	<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-14 md:py-20">

		<div class="grid gap-12 md:gap-16 md:grid-cols-[1.4fr_1fr_1fr_1fr]">

			<div>
				<a href="/" class="font-serif text-h3 text-ink hover:text-accent transition-colors">
					Orcas Prime
				</a>
				<p class="text-small text-ink-muted mt-4 leading-relaxed max-w-xs">
					We take ownership of your ecommerce growth. <span class="num text-accent">3.5%</span> of net sales, no retainer.
				</p>
				<p class="text-small text-ink-muted mt-6 leading-relaxed">
					Built and run by<br />
					<span class="text-ink">{founders[0]}</span> &nbsp;·&nbsp;
					<span class="text-ink">{founders[1]}</span>
				</p>
			</div>

			<nav aria-label="What We Own" class="min-w-0">
				<h2 class="kicker mb-4">
					<a href="/services" class="hover:text-accent transition-colors">What We Own</a>
				</h2>
				<ul class="space-y-2.5">
					{footerNav.work.map((item) => (
						<li>
							<a href={item.href} class="font-sans text-small text-ink hover:text-accent transition-colors">
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<nav aria-label="Proof" class="min-w-0">
				<h2 class="kicker mb-4">Proof</h2>
				<ul class="space-y-2.5">
					{footerNav.proof.map((item) => (
						<li>
							<a href={item.href} class="font-sans text-small text-ink hover:text-accent transition-colors">
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<div class="min-w-0">
				<h2 class="kicker mb-4">Start</h2>
				<ul class="space-y-2.5">
					{footerNav.start.map((item) => (
						<li>
							<a href={item.href} class="font-sans text-small text-ink hover:text-accent transition-colors">
								{item.label}
							</a>
						</li>
					))}
				</ul>

				<h2 class="kicker mt-8 mb-4">Contact</h2>
				<address class="not-italic space-y-2.5 text-small">
					<p>
						<a
							href={`https://wa.me/${contact.whatsapp.replace(/[^0-9]/g,'')}`}
							class="text-ink hover:text-accent transition-colors"
						>
							WhatsApp <span class="num text-ink-muted">{contact.whatsapp}</span>
						</a>
					</p>
					<p>
						<a href={`mailto:${contact.email}`} class="text-ink hover:text-accent transition-colors">
							{contact.email}
						</a>
					</p>
					<p class="text-ink-muted num">
						{contact.phone}
					</p>
				</address>
			</div>
		</div>

		<hr class="mt-14 border-t border-rule" />

		<div class="mt-8 grid gap-6 md:grid-cols-[1fr_auto] items-start">
			<address class="not-italic text-small text-ink-muted">
				<span class="text-ink">Orcas Prime</span> · {addressLine}
			</address>
			<p class="font-mono text-micro text-ink-muted uppercase tracking-wider md:text-right">
				© <span class="num">{year}</span> Orcas Prime. All rights reserved.
			</p>
		</div>

	</div>
</footer>
