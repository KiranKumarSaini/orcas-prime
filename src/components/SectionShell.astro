---
/**
 * Every homepage section goes through this.
 *
 * REVISED 2026-08-08 after operator review on a real phone: the dark
 * surfaces are gone and sections are now rounded panels floating on a deeper
 * page colour.
 *
 * Why the change. Module 9 §3 alternated light/dark to mark changes of
 * register. On desktop that worked; on a phone the dark sections are so tall
 * that they read as "a long dark zone" rather than as a beat in a rhythm, and
 * the hairline borders separating light sections are effectively invisible at
 * that width — so the whole page still scanned as one continuous document.
 *
 * Separation now comes from geometry rather than darkness: each section is a
 * physically separate rounded object with its own tint. Light-only, per
 * operator instruction.
 *
 * width:
 *   'wide'    — side-by-side content (4, 6)
 *   'reading' — long-form (2, 3, 5)
 *   'narrow'  — the close (8)
 */
export interface Props {
  width?: 'wide' | 'reading' | 'narrow';
  /** Panel tint. All light — see the note above. */
  surface?: 'paper' | 'sunken' | 'accent' | 'raised';
  /** Render as a floating rounded panel. Off only for full-bleed sections. */
  panel?: boolean;
  animate?: boolean;
  id?: string;
  class?: string;
}
const {
  width = 'wide',
  surface = 'paper',
  panel = true,
  animate = true,
  id,
  class: extraClass = '',
} = Astro.props;

const widths = {
  wide: 'max-w-[76rem]',
  reading: 'max-w-[44rem]',
  narrow: 'max-w-[37.5rem]',
} as const;

const surfaces = {
  paper: 'bg-paper',
  sunken: 'bg-paper-sunken',
  accent: 'bg-accent-wash',
  raised: 'bg-paper-raised',
} as const;
---
<section
	id={id}
	class:list={[
		surfaces[surface],
		panel ? 'panel my-3 md:my-4' : '',
	]}
>
	<div
		class:list={[
			widths[width],
			'mx-auto px-6 md:px-10 py-12 md:py-20',
			extraClass,
		]}
		data-animate-group={animate ? '' : undefined}
	>
		<slot />
	</div>
</section>
