---
/**
 * "Five become one" — Module 10 §4, Moment 1.
 *
 * The hero headline says "Stop managing five different agencies. We're one
 * team." This draws it: five thin outlined bars sitting at uneven angles slide
 * together, straighten, and resolve into one solid accent bar.
 *
 * It earns its place because it states the headline's claim before the
 * sentence has finished being read — not because motion looks modern.
 *
 * Fires once, never loops, never re-triggers on scroll-back.
 * Reduced motion / no JS → renders in the resolved end state, which is the
 * point of the visual anyway. Nothing is lost.
 */
---

<div class="sv-converge mt-10" aria-hidden="true">
	<div class="sv-converge-track">
		{[0, 1, 2, 3, 4].map((i) => (
			<span class="sv-converge-bar" data-i={i}></span>
		))}
		<span class="sv-converge-solid"></span>
	</div>
	<p class="font-mono text-micro tracking-wider text-ink-muted mt-3">
		<span class="sv-converge-label" data-state="before">Five vendors</span>
		<span class="sv-converge-label" data-state="after">One team</span>
	</p>
</div>

<style>
	.sv-converge-track {
		position: relative;
		height: 34px;
		max-width: 320px;
	}

	/* Resolved state is the DEFAULT — the solid bar is what renders with no JS
	   and under reduced motion. The scattered bars only exist once armed. */
	.sv-converge-bar {
		position: absolute;
		top: 50%;
		left: 0;
		width: 56px;
		height: 10px;
		border: 1px solid var(--color-accent);
		border-radius: 999px;
		opacity: 0;
		transform: translateY(-50%);
	}
	.sv-converge-solid {
		position: absolute;
		top: 50%;
		left: 0;
		width: 100%;
		height: 10px;
		background: var(--color-accent);
		border-radius: 999px;
		transform: translateY(-50%) scaleX(1);
		transform-origin: left center;
	}

	.sv-converge-label[data-state='before'] { display: none; }
	.sv-converge-label[data-state='after'] { display: inline; }

	/* Armed: scatter the five, hide the solid, then let JS resolve them. */
	.sv-converge.is-armed .sv-converge-bar {
		opacity: 1;
		transition:
			transform 900ms cubic-bezier(0.16, 1, 0.3, 1),
			opacity 300ms ease-out 600ms;
	}
	.sv-converge.is-armed .sv-converge-solid {
		transform: translateY(-50%) scaleX(0);
		transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1) 400ms;
	}
	.sv-converge.is-armed .sv-converge-label[data-state='before'] { display: inline; }
	.sv-converge.is-armed .sv-converge-label[data-state='after'] { display: none; }

	/* Scattered positions — uneven on purpose; a tidy row wouldn't read as
	   "five different agencies". */
	.sv-converge.is-armed .sv-converge-bar[data-i='0'] { transform: translate(2px, -22px) rotate(-7deg); }
	.sv-converge.is-armed .sv-converge-bar[data-i='1'] { transform: translate(74px, 4px) rotate(5deg); }
	.sv-converge.is-armed .sv-converge-bar[data-i='2'] { transform: translate(146px, -26px) rotate(-3deg); }
	.sv-converge.is-armed .sv-converge-bar[data-i='3'] { transform: translate(210px, 8px) rotate(9deg); }
	.sv-converge.is-armed .sv-converge-bar[data-i='4'] { transform: translate(262px, -14px) rotate(-5deg); }

	/* Resolved: all five slide to the baseline and align, then the solid wipes
	   in over them. */
	.sv-converge.is-resolved .sv-converge-bar {
		transform: translateY(-50%) rotate(0deg) !important;
		opacity: 0;
	}
	.sv-converge.is-resolved .sv-converge-solid {
		transform: translateY(-50%) scaleX(1);
	}
	.sv-converge.is-resolved .sv-converge-label[data-state='before'] { display: none; }
	.sv-converge.is-resolved .sv-converge-label[data-state='after'] { display: inline; }

	@media (prefers-reduced-motion: reduce) {
		.sv-converge-bar { display: none; }
		.sv-converge-solid { transform: translateY(-50%) scaleX(1) !important; transition: none; }
	}
</style>

<script>
	import { prefersReducedMotion, onceInView } from '../lib/motion';

	const el = document.querySelector<HTMLElement>('.sv-converge');

	if (el && !prefersReducedMotion()) {
		// Arm into the scattered state, then resolve. Arming happens only here,
		// so a no-JS visitor keeps the resolved bar that's in the base CSS.
		el.classList.add('is-armed');

		onceInView(
			el,
			() => {
				// Let the scattered state be visible briefly before it resolves —
				// without this the whole thing reads as one blur.
				window.setTimeout(() => el.classList.add('is-resolved'), 550);
			},
			{ threshold: 0.5, fallbackDelayMs: 2500 }
		);
	}
</script>
