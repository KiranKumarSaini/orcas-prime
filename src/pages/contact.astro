---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import Schema from '../components/Schema.astro';
import { breadcrumb } from '../lib/schema';
import { SITE } from '../lib/site';
import { founders } from '../data/founders';

/*
  /contact — WhatsApp-first (§9). Indian sellers frequently won't fill
  forms, email, or book a Calendly. So: no form. Pre-written messages for
  each situation, one tap each, zero typing.
*/

// Each entry is a real decision moment with its own pre-filled message (§9).
const routes = [
  {
    kicker: 'Most people start here',
    title: 'I want to check if the 3.5% model fits my store',
    detail:
      'Existing Shopify store, doing revenue, want to know whether the numbers work. Tell us roughly what you do monthly and we will say honestly.',
    message: 'Hi, I want to check if the 3.5% model fits my store.',
    primary: true,
  },
  {
    kicker: 'Not on Amazon yet',
    title: 'I want to start the free 3-month Amazon onboarding',
    detail:
      'We open the account, list your products, and run it for three months at no cost. No lock-in after.',
    message: 'Hi, I want to start selling on Amazon with the free 3-month onboarding.',
    primary: false,
  },
  {
    kicker: 'No store yet',
    title: 'I want a quote for a new Shopify store',
    detail:
      '₹10,000–₹20,000 one-time depending on scope. Tell us how many products and we will give you a number.',
    message: 'Hi, I want a quote for a new Shopify store.',
    primary: false,
  },
  {
    kicker: 'The RTO problem',
    title: 'I want to know how you handle RTO',
    detail:
      'Returns and refused deliveries are the thing that quietly kills Indian D2C margin. Ask us what we actually do about it.',
    message: 'Hi, I want to know how you handle RTO.',
    primary: false,
  },
];

const waDigits = SITE.contact.whatsapp.replace(/[^0-9]/g, '');
---

<BaseLayout
	title="Contact"
	description="WhatsApp is the fastest way to reach Orcas Prime. Pre-written messages for pricing, free Amazon onboarding, a store quote, or RTO. No forms."
	canonicalPath="/contact"
>
	<Schema
		slot="head"
		data={breadcrumb([
			{ name: 'Home', path: '/' },
			{ name: 'Contact', path: '/contact' },
		])}
	/>

	{/* ─── 1 · Hero ────────────────────────────────────────────────── */}
	<section class="bg-paper panel mt-3 md:mt-4 mb-3 md:mb-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 pt-14 md:pt-24 pb-12">
			<p class="kicker mb-4">Contact</p>
			<h1 class="text-display font-serif max-w-[20ch]">
				WhatsApp. No form.
			</h1>
			<p class="text-lead text-ink mt-6 max-w-prose leading-relaxed">
				Pick whichever line below is closest to your situation. The message is
				already written &mdash; tap it and hit send. One of the two of us replies
				the same working day.
			</p>
		</div>
	</section>

	{/* ─── 2 · The four pre-written routes ─────────────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-12 md:py-16">
			<ul class="grid gap-6 md:grid-cols-2">
				{routes.map((r) => (
					<li
						class:list={[
							'border rounded p-6 md:p-8 flex flex-col',
							r.primary ? 'border-accent bg-accent-wash/50' : 'border-rule bg-paper',
						]}
					>
						<p
							class:list={[
								'font-mono text-micro uppercase tracking-wider mb-3',
								r.primary ? 'text-accent' : 'text-ink-muted',
							]}
						>
							{r.kicker}
						</p>
						<h2 class="font-serif text-h3 font-medium text-ink">{r.title}</h2>
						<p class="text-base text-ink-muted leading-relaxed mt-3 flex-1">
							{r.detail}
						</p>
						<div class="mt-6">
							<WhatsAppCTA
								message={r.message}
								variant={r.primary ? 'primary' : 'ghost'}
								label="Send this on WhatsApp"
							/>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>

	{/* ─── 3 · Other ways ──────────────────────────────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
			<div class="grid gap-10 md:grid-cols-[1fr_1fr] md:gap-16 items-start">
				<div>
					<p class="kicker mb-4">Other ways</p>
					<h2 class="text-h1 font-serif">
						If WhatsApp isn't your thing.
					</h2>
					<p class="text-base text-ink-muted leading-relaxed mt-6 max-w-prose">
						Email works too, it's just slower. We don't run a phone queue &mdash;
						if you call, you get one of us or you get voicemail.
					</p>
				</div>

				<dl class="border-t border-rule">
					<div class="grid grid-cols-[7rem_1fr] gap-4 py-5 border-b border-rule items-baseline">
						<dt class="kicker">WhatsApp</dt>
						<dd>
							<a
								href={`https://wa.me/${waDigits}`}
								rel="noopener"
								class="num text-accent hover:text-accent-hover link-draw"
							>
								{SITE.contact.whatsapp}
							</a>
						</dd>
					</div>
					<div class="grid grid-cols-[7rem_1fr] gap-4 py-5 border-b border-rule items-baseline">
						<dt class="kicker">Email</dt>
						<dd>
							<a
								href={`mailto:${SITE.contact.email}`}
								class="text-ink hover:text-accent link-draw"
							>
								{SITE.contact.email}
							</a>
						</dd>
					</div>
					<div class="grid grid-cols-[7rem_1fr] gap-4 py-5 border-b border-rule items-baseline">
						<dt class="kicker">Phone</dt>
						<dd class="num text-ink-muted">{SITE.contact.phone}</dd>
					</div>
					<div class="grid grid-cols-[7rem_1fr] gap-4 py-5 border-b border-rule items-baseline">
						<dt class="kicker">Where</dt>
						<dd>
							<address class="not-italic text-small text-ink-muted leading-relaxed">
								{SITE.address.street}<br />
								{SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}<br />
								India
							</address>
						</dd>
					</div>
					<div class="grid grid-cols-[7rem_1fr] gap-4 py-5 border-b border-rule items-baseline">
						<dt class="kicker">Who replies</dt>
						<dd class="text-small text-ink-muted">
							{founders.map((f) => f.name).join(' or ')} &mdash; there is nobody else.
						</dd>
					</div>
				</dl>
			</div>
		</div>
	</section>

	{/* ─── 4 · Honest capacity note (§9 real scarcity) ─────────────── */}
	<section class="bg-accent-wash panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24 text-center">
			<p class="font-serif text-h2 max-w-[34ch] mx-auto">
				We take on four new Partner Brands a quarter, because there are two of us.
			</p>
			<p class="text-lead text-ink-muted mt-4 max-w-prose mx-auto">
				If we're full when you message, we'll tell you when the next slot opens
				rather than taking the account and under-serving it.
			</p>
			<p class="text-small text-ink-muted mt-8">
				<a href="/how-we-work" class="text-accent hover:text-accent-hover link-draw">
					How we work &rarr;
				</a>
			</p>
		</div>
	</section>

</BaseLayout>
