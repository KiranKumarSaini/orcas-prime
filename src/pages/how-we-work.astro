---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import Timeline from '../components/Timeline.astro';
import Schema from '../components/Schema.astro';
import { faqPage, breadcrumb } from '../lib/schema';

/*
  /how-we-work — process, reporting cadence, what a client should expect.
  A proof page (§6): its job is to make the agency believable by being
  specific about the boring operational reality.
*/

const onboarding = [
  {
    when: 'Day 0',
    title: 'One WhatsApp conversation',
    detail:
      'We ask what you sell, roughly what you do in monthly revenue, what your return rate looks like, and what is currently broken. If we are not the right fit we say so here, not after you have paid us.',
  },
  {
    when: 'Day 1–2',
    title: 'Access, not paperwork',
    detail:
      'You add us as users on your Shopify, ad accounts, and seller dashboards. We never ask you to transfer ownership of anything. You can revoke access from your own admin at any time.',
  },
  {
    when: 'Week 1',
    title: 'Audit before we touch anything',
    detail:
      'We go through the store, the campaigns, the catalogue, and the last 90 days of returns. You get a plain-language write-up of what we found and what we intend to change first.',
  },
  {
    when: 'Week 2',
    title: 'First changes go live',
    detail:
      'Usually the highest-leverage fixes: wasted ad spend, broken tracking, listing gaps, checkout friction. Small, reversible, measurable.',
  },
  {
    when: 'Month 2 onward',
    title: 'The loop',
    detail:
      'Weekly account work, monthly reporting, and a running WhatsApp thread for anything that cannot wait for the report.',
  },
];

const reporting = [
  {
    cadence: 'Daily',
    what: 'Ad account monitoring',
    detail: 'Spend pacing and anomalies. You only hear from us if something needs a decision.',
  },
  {
    cadence: 'Weekly',
    what: 'Account work',
    detail: 'Campaign adjustments, listing updates, creative rotation, RTO dispute filing.',
  },
  {
    cadence: 'Monthly',
    what: 'The report',
    detail: 'Revenue, spend, ROAS, return rate, and what we changed. Plain language, no vanity metrics.',
  },
  {
    cadence: 'Quarterly',
    what: 'Direction review',
    detail: 'What is working, what to stop, where the next quarter of budget should go.',
  },
];

const expectations = [
  {
    heading: 'What we need from you',
    items: [
      'Product images and titles — you know your product better than we do',
      'A decision-maker who can reply on WhatsApp within a day',
      'Honest numbers on margin, so we do not scale something unprofitable',
      'Stock availability updates before we push spend behind a SKU',
    ],
  },
  {
    heading: 'What you get from us',
    items: [
      'Both founders reachable directly, no account manager',
      'Everything in your own accounts, revocable at any time',
      'A monthly report you can actually read',
      'An honest answer when something is not working',
    ],
  },
];

const faqs = [
  {
    question: 'How quickly do you reply on WhatsApp?',
    answer:
      'Same working day, usually within a few hours. If something is on fire — spend running away, store down, listing suspended — faster than that. We do not run a ticket system.',
  },
  {
    question: 'Who owns the ad accounts and the store?',
    answer:
      'You do, always. We work as added users inside your accounts. Nothing is registered under Orcas Prime, and you can remove our access from your own admin without asking us.',
  },
  {
    question: 'What happens if we want to stop?',
    answer:
      'Thirty days\' notice so we can hand over cleanly — documentation of what is running, where, and why. No exit fee, no minimum term. The accounts are already yours, so there is nothing to claw back.',
  },
  {
    question: 'Do you work with competitors in the same category?',
    answer:
      'No. If we are running a kurta brand, we will not take on a second kurta brand in the same price band. Tell us your category when you message and we will say straight away whether it is clear.',
  },
  {
    question: 'What if the numbers do not improve?',
    answer:
      'Because we are paid on a percentage of net sales, a bad month costs us too. If three months in the trend is flat, we will tell you what we think is wrong — even if the answer is that the product or the pricing, not the marketing, is the constraint.',
  },
];

const ctaMsg = 'Hi, I want to understand how you would work with my store.';
---

<BaseLayout
	title="How we work"
	description="Onboarding in a week, weekly account work, monthly reporting in plain language. You keep ownership of every account. Thirty days' notice to stop, no exit fee."
	canonicalPath="/how-we-work"
>
	<Schema
		slot="head"
		data={[
			faqPage(faqs),
			breadcrumb([
				{ name: 'Home', path: '/' },
				{ name: 'How we work', path: '/how-we-work' },
			]),
		]}
	/>

	{/* ─── 1 · Hero ────────────────────────────────────────────────── */}
	<section class="bg-paper panel mt-3 md:mt-4 mb-3 md:mb-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 pt-14 md:pt-24 pb-12">
			<p class="kicker mb-4">How we work</p>
			<h1 class="text-display font-serif max-w-[22ch]">
				One conversation, then the work starts.
			</h1>
			<p class="text-lead text-ink mt-6 max-w-prose leading-relaxed">
				No pitch deck, no discovery workshop, no onboarding fee. We look at what
				you have, tell you what we would change, and start changing it. Everything
				stays in your accounts.
			</p>
		</div>
	</section>

	{/* ─── 2 · Onboarding timeline ─────────────────────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
			<p class="kicker mb-4">Getting started</p>
			<h2 class="text-h1 font-serif max-w-[22ch]">
				The first month.
			</h2>

			<Timeline steps={onboarding} />
		</div>
	</section>

	{/* ─── 3 · Reporting cadence ───────────────────────────────────── */}
	<section class="bg-accent-wash panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
			<p class="kicker mb-4">Cadence</p>
			<h2 class="text-h1 font-serif max-w-[24ch]">
				What happens, and how often.
			</h2>

			<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{reporting.map((r) => (
					<div class="bg-paper border border-rule rounded p-6">
						<p class="font-mono text-micro uppercase tracking-wider text-accent mb-3">
							{r.cadence}
						</p>
						<h3 class="font-serif text-h3 font-medium text-ink">{r.what}</h3>
						<p class="text-small text-ink-muted leading-relaxed mt-3">{r.detail}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	{/* ─── 4 · Mutual expectations ─────────────────────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
			<p class="kicker mb-4">Expectations</p>
			<h2 class="text-h1 font-serif max-w-[24ch]">
				What each side brings.
			</h2>

			<div class="mt-12 grid gap-10 md:grid-cols-2 md:gap-16">
				{expectations.map((col) => (
					<div>
						<h3 class="font-serif text-h2 font-medium text-ink mb-6">
							{col.heading}
						</h3>
						<ul class="border-t border-rule">
							{col.items.map((item) => (
								<li class="grid grid-cols-[1.25rem_1fr] gap-3 py-4 border-b border-rule text-base text-ink-muted leading-relaxed">
									<span aria-hidden="true" class="font-mono text-accent">&mdash;</span>
									<span>{item}</span>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</div>
	</section>

	{/* ─── 5 · FAQ ─────────────────────────────────────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
			<p class="kicker mb-4">Questions</p>
			<h2 class="text-h1 font-serif max-w-[22ch]">
				The practical questions.
			</h2>

			<div class="mt-12 max-w-prose border-t border-rule">
				{faqs.map((qa) => (
					<details class="group border-b border-rule py-5" open>
						<summary class="cursor-pointer list-none flex items-start gap-4">
							<span aria-hidden="true" class="kicker mt-2 text-accent num">Q</span>
							<h3 class="font-serif text-h3 font-medium text-ink flex-1">
								{qa.question}
							</h3>
						</summary>
						<p class="mt-4 pl-9 text-base text-ink-muted leading-relaxed">
							{qa.answer}
						</p>
					</details>
				))}
			</div>
		</div>
	</section>

	{/* ─── 6 · Close ───────────────────────────────────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24 text-center">
			<p class="font-serif text-h2 max-w-[28ch] mx-auto">
				Day 0 is a WhatsApp message.
			</p>
			<p class="text-lead text-ink-muted mt-4">
				It's already written &mdash; just hit send.
			</p>
			<div class="mt-8 flex justify-center">
				<WhatsAppCTA message={ctaMsg} />
			</div>
		</div>
	</section>

</BaseLayout>
