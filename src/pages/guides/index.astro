---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import Schema from '../../components/Schema.astro';
import { breadcrumb } from '../../lib/schema';
import { getCollection } from 'astro:content';

/*
  /guides — the answer hub (§6, §7 Layer 3).

  These pages exist to be cited by ChatGPT, Claude, Perplexity, and Google
  AI Overviews. Every one answers a question an Indian ecommerce seller
  actually asks, from operating experience, with a direct answer up top.
*/

const all = await getCollection('guides', ({ data }) => !data.draft);
const guides = all.sort(
  (a, b) => b.data.updated.getTime() - a.data.updated.getTime()
);

// Group by category so the hub reads as a reference index, not a blog feed.
const byCategory = guides.reduce<Record<string, typeof guides>>((acc, g) => {
  (acc[g.data.category] ??= []).push(g);
  return acc;
}, {});

const categories = Object.keys(byCategory).sort();

const ctaMsg = 'Hi, I read one of your guides — I want to talk about my store.';
---

<BaseLayout
	title="Guides"
	description="Direct answers to the questions Indian ecommerce sellers actually ask — agency costs, RTO, marketplace economics, ad budgets. Written from accounts we run."
	canonicalPath="/guides"
>
	<Schema
		slot="head"
		data={breadcrumb([
			{ name: 'Home', path: '/' },
			{ name: 'Guides', path: '/guides' },
		])}
	/>

	{/* ─── 1 · Hero ────────────────────────────────────────────────── */}
	<section class="bg-paper panel mt-3 md:mt-4 mb-3 md:mb-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 pt-14 md:pt-24 pb-12">
			<p class="kicker mb-4">Guides</p>
			<h1 class="text-display font-serif max-w-[22ch]">
				Straight answers, from accounts we actually run.
			</h1>
			<p class="text-lead text-ink-muted mt-6 max-w-prose leading-relaxed">
				Questions Indian ecommerce sellers ask us, answered properly. The answer is
				at the top of every page &mdash; scroll only if you want the detail behind it.
			</p>
		</div>
	</section>

	{/* ─── 2 · The index ───────────────────────────────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-12 md:py-16">
			{guides.length === 0 ? (
				<p class="font-mono text-small text-ink-muted">
					First guides publishing shortly.
				</p>
			) : (
				<div class="space-y-14">
					{categories.map((cat) => (
						<div>
							<h2 class="kicker mb-6">{cat}</h2>
							<ul class="border-t border-rule">
								{byCategory[cat].map((g) => (
									<li class="border-b border-rule">
										<a
											href={`/guides/${g.id}`}
											class="group grid gap-2 md:gap-8 md:grid-cols-[1fr_auto] py-6 items-baseline hover:bg-accent-wash/50 -mx-4 px-4 md:-mx-6 md:px-6 rounded transition-colors"
										>
											<div>
												<h3 class="font-serif text-h3 font-medium text-ink group-hover:text-accent transition-colors">
													{g.data.question}
												</h3>
												<p class="text-base text-ink-muted leading-relaxed mt-2 max-w-[62ch]">
													{g.data.directAnswer}
												</p>
											</div>
											<span class="font-mono text-micro text-ink-muted whitespace-nowrap">
												{g.data.updated.toISOString().slice(0, 10)}
											</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			)}
		</div>
	</section>

	{/* ─── 3 · Close ───────────────────────────────────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24 text-center">
			<p class="font-serif text-h2 max-w-[32ch] mx-auto">
				Question we haven't answered yet?
			</p>
			<p class="text-lead text-ink-muted mt-4">
				Ask it on WhatsApp. If it's a good one, it becomes the next guide.
			</p>
			<div class="mt-8 flex justify-center">
				<WhatsAppCTA message={ctaMsg} />
			</div>
		</div>
	</section>

</BaseLayout>
