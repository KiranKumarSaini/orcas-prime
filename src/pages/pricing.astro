---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingTable from '../components/PricingTable.astro';
import FeeCalculator from '../components/FeeCalculator.astro';
import HireCompare from '../components/HireCompare.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import Schema from '../components/Schema.astro';
import { faqPage, breadcrumb } from '../lib/schema';
import { SITE } from '../lib/site';

/*
  /pricing — the most strategically important page (Prompt 8).
  Structure follows PROJECT-BRIEF.md §4 + §7 Layer 3 extraction rules:
    - Direct answer in the first 40 words (h1 + lead)
    - Full price list next
    - Comparison table with cited sources
    - What's covered
    - Why we publish
    - Real FAQ with FAQPage schema
    - Contextual WhatsApp close

  RULES (§4):
    - Publish as "₹20,000/month or 4% of net sales, whichever is higher, + GST",
      never GST-inclusive (decided 2026-11-06).
    - Never mention that the rate is negotiable.
    - Do NOT include the ₹2,000 security deposit — handled off-site.
*/

// Priced items — verbatim from §4. Do not add rows without brief approval.
const priceRows = [
  {
    item: 'Shopify growth management — everything included',
    price: '₹20,000/month',
    detail: 'or 4% of net sales after returns and RTOs, whichever is higher, plus GST',
  },
  {
    item: 'New Shopify store build',
    price: '₹10,000–₹20,000',
    detail: 'one-time, depending on scope, ready in about 7 days',
  },
  {
    item: 'Setup, onboarding, creative, reporting fees',
    price: 'None',
    detail: 'all included in the monthly fee',
  },
  {
    item: 'Lock-in contract',
    price: 'None',
    detail: 'stop whenever you like, no notice period, no exit fee',
  },
];

const scope = [
  { label: 'Meta and Google Ads',   desc: 'Build, run, adjust, inside your own ad accounts. Pixel and CAPI tracking, free Google Merchant Center listings.' },
  { label: 'Shopify store',         desc: 'Day-to-day changes and fixes, the whole admin.' },
  { label: 'Profit dashboard',      desc: 'Daily, weekly and monthly P&L after RTO, shipping and ads. Every ad marked Scale, Keep or Cut.' },
  { label: 'RTO, COD and NDR',      desc: 'COD confirmed on WhatsApp, risky pincodes blocked, prepaid nudges, NDR call list.' },
  { label: 'AI photos and video',   desc: 'Model shots from hanger or flat-lay photos for the whole catalogue, and up to 10 AI video ads a month.' },
  { label: 'WhatsApp and Instagram', desc: 'Abandoned cart, order updates, reorder reminders, festive broadcasts. Reels, captions, posting.' },
  { label: 'Festive calendar',      desc: 'Diwali, wedding season, Rakhi, end-of-season sale. Planned 4–6 weeks ahead.' },
  { label: 'Reports and a weekly call', desc: 'A daily summary and weekly report on WhatsApp, and a 15-minute review call every week.' },
];

const faqs = [
  {
    question: 'How is the fee worked out?',
    answer:
      'Each month you pay ₹20,000 or 4% of your net sales, whichever is higher, plus GST. The two meet at ₹5 lakh of net sales: below that you pay ₹20,000, above it you pay 4%. At ₹10 lakh of net sales, for example, the fee is ₹40,000 + GST.',
  },
  {
    question: 'What counts as "net sales"?',
    answer:
      'Net sales is the money that stayed with your business after refunds, returns, and RTOs are deducted. If a customer refuses delivery and the shipment comes back, that transaction is removed from the base we charge on. This is different from gross revenue, which most agencies use.',
  },
  {
    question: 'Does the fee include GST?',
    answer:
      'No. GST is added on top at the government rate (currently 18%), and you get a GST invoice every month. We publish the fee before GST to stay directly comparable to other agencies’ rates.',
  },
  {
    question: 'What does "no lock-in" mean?',
    answer:
      'You can stop whenever you like. No notice period, no exit fee, no minimum term. Your ad accounts and your store are already yours, so there is nothing to hand back.',
  },
  {
    question: 'What size store is this best for?',
    answer:
      'Shopify brands doing roughly ₹3–50 lakh a month in net sales. Below ₹3 lakh, the ₹20,000 minimum is a big share of your sales, and we’d rather say so in the first conversation than take the account. Above ₹50 lakh the model still works, but a fixed retainer may suit you better — we’ll tell you that too.',
  },
  {
    question: 'What if I only want ads run, not store management?',
    answer:
      'The fee covers everything as one bundle — ads, store, creative, RTO and reporting. We don’t split it into "just ads." If you only need one piece, a specialist will serve you better than we would.',
  },
  {
    question: 'Do you manage Amazon, Flipkart or Meesho?',
    answer:
      'Yes, for a flat ₹20,000 + GST a month, charged separately from Shopify management. Our focus is Shopify, so we take on only a few marketplace accounts.',
  },
];

const ctaMsg = 'Hi, I want to understand the Orcas Prime fee for my store.';
const correctionMsg = 'Hi, I have an agency quote you should see for your pricing footnote.';
const waDigits = SITE.contact.whatsapp.replace(/[^0-9]/g, '');
const correctionHref = `https://wa.me/${waDigits}?text=${encodeURIComponent(correctionMsg)}`;
---

<BaseLayout
	title="Pricing"
	description="Orcas Prime charges ₹20,000 a month or 4% of net sales after returns, whichever is higher, plus GST. A Shopify build is ₹10,000–₹20,000 one-time. No lock-in, no setup fees."
	canonicalPath="/pricing"
	stickyMessage={ctaMsg}
>
	<Schema
		slot="head"
		data={[
			faqPage(faqs),
			breadcrumb([
				{ name: 'Home', path: '/' },
				{ name: 'Pricing', path: '/pricing' },
			]),
		]}
	/>

	{/* ─── 1 · Direct answer (first 40 words for AI extraction) ────── */}
	<section class="bg-paper panel mt-3 md:mt-4 mb-3 md:mb-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 pt-14 md:pt-24 pb-12">
			<p class="kicker mb-4">Pricing</p>
			<h1 class="text-display font-serif max-w-[20ch]">
				One fee. Everything included.
			</h1>
			<p class="text-lead text-ink mt-6 max-w-prose leading-relaxed">
				Orcas Prime charges <span class="num text-accent">₹20,000</span> a month or <span class="num text-accent">4%</span> of net sales after returns and RTOs, whichever is higher, plus GST. That covers Meta and Google ads, your Shopify store, RTO control, AI photos and video, and a profit dashboard. A new Shopify store is <span class="num">₹10,000–₹20,000</span> one-time. No lock-in, no setup fees.
			</p>
		</div>
	</section>

	{/* ─── The three ways agencies get paid — incentive explanation, not a competitor attack (LOCKED#26) ─── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
			<p class="kicker mb-4">Why this structure</p>
			<h2 class="text-h1 font-serif max-w-[24ch]">
				There are three ways an agency can be paid. Ours is built to think about your business the way you do.
			</h2>
			<div class="mt-10 grid gap-10 md:grid-cols-3 md:gap-12">
				<div>
					<p class="kicker text-ink-muted mb-3">A big retainer</p>
					<p class="text-base leading-relaxed text-ink-muted">
						Usually ₹75,000 and up, billed the same whether your store made money or lost money last month. Neither side's incentive changes with the result.
					</p>
				</div>
				<div>
					<p class="kicker text-ink-muted mb-3">A percentage of ad spend</p>
					<p class="text-base leading-relaxed text-ink-muted">
						Bills more as spend goes up, regardless of whether that spend converted into money you actually kept.
					</p>
				</div>
				<div class="border-l-2 border-accent pl-6 md:pl-8">
					<p class="kicker text-accent mb-3">A small minimum + 4% of net sales</p>
					<p class="text-base leading-relaxed text-ink">
						₹20,000 keeps the work funded. Above ₹5 lakh, the fee tracks the money that actually stayed in your account after refunds, returns and RTOs. A refused shipment comes out of the base we charge on.
					</p>
				</div>
			</div>
			<p class="text-base text-ink-muted mt-10 max-w-prose">
				Nobody on the first two models is doing anything wrong — they're doing exactly what their pricing rewards. We built Orcas Prime on the third because it pays us more only when you keep more.
			</p>

			{/* Surfaced here as well as on /about — this is the point in the page
			    where the reader is actively weighing the model, and exclusivity
			    is part of what they are being offered for the fee. */}
			<p class="text-base text-ink-muted mt-6 max-w-prose">
				We also won't run two brands in the same category and price band. Your
				competitor cannot hire us while we have you.
				<a href="/how-we-work" class="text-accent hover:text-accent-hover link-draw ml-1">
					How we work &rarr;
				</a>
			</p>
		</div>
	</section>

	{/* ─── 2 · The full price list ─────────────────────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
			<p class="kicker mb-4">The list</p>
			<h2 class="text-h1 font-serif max-w-[22ch]">
				The full price list.
			</h2>

			<dl class="mt-12 border-t border-rule-strong">
				{priceRows.map((row) => (
					<div class="grid gap-2 md:gap-8 md:grid-cols-[1fr_auto_1.2fr] py-6 border-b border-rule items-baseline">
						<dt class="font-serif text-h3 font-medium text-ink">{row.item}</dt>
						<dd class="num text-lead text-accent md:text-right whitespace-nowrap">{row.price}</dd>
						<dd class="text-small text-ink-muted leading-relaxed">{row.detail}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	{/* ─── 3 · Comparison + footnoted sources ──────────────────────── */}
	<section class="bg-accent-wash panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
			<p class="kicker mb-4">The comparison</p>
			<h2 class="text-h1 font-serif max-w-[24ch]">
				What you’d pay a typical retainer agency.
			</h2>
			<p class="text-lead text-ink-muted mt-6 max-w-prose">
				Same net sales, three price points side by side. Retainer agencies charge the same
				whether the month worked or not.
			</p>

			<div class="mt-12 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-start">
				{/* Module 10 §4, Moment 3. The pricing page is this component's real
				    home — it's the page most likely to be cited when someone asks
				    an AI what Indian ecommerce agencies charge. */}
				<FeeCalculator default={1000000} />
				<PricingTable id="pricing-comparison" />
			</div>

			<div class="mt-8 max-w-prose text-small text-ink-muted leading-relaxed space-y-3">
				<p class="kicker text-ink" id="sources">Sources</p>
				<p>
					<sup class="num text-accent">1</sup>&nbsp;Ranges compiled from publicly available
					agency rate pages, industry directory listings on Clutch, DesignRush and Sortlist,
					and public LinkedIn descriptions for Indian ecommerce agencies as of Q3 2026.
				</p>
				<p>
					<sup class="num text-accent">2</sup>&nbsp;Retainer range for Indian ecommerce
					agencies: <span class="num">₹75,000</span>–<span class="num">₹10,00,000</span> per month, most commonly <span class="num">₹1,50,000</span>–<span class="num">₹6,00,000</span>. Percentage-of-ad-spend pricing commonly runs 10–20% of media budget.
				</p>
				<p class="pt-2 font-mono text-micro">
					If you have an agency quote that undercuts this range,
					<a
						href={correctionHref}
						rel="noopener"
						class="text-accent link-draw hover:text-accent-hover"
					>
						send it over &mdash; we’ll update the footnote.
					</a>
				</p>
			</div>
		</div>
	</section>

	{/* ─── 4 · What the fee covers ────────────────────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
			<p class="kicker mb-4">What’s covered</p>
			<h2 class="text-h1 font-serif max-w-[22ch]">
				What the fee covers.
			</h2>
			<p class="text-lead text-ink-muted mt-6 max-w-prose">
				One fee. Everything you need to run and grow the store.
			</p>
			<HireCompare class="mt-10 max-w-prose" />

			<dl class="mt-12 grid gap-x-12 md:grid-cols-2 border-t border-rule">
				{scope.map((item) => (
					<div class="grid grid-cols-[1fr_2fr] gap-6 py-5 border-b border-rule items-baseline">
						<dt class="font-serif text-h3 font-medium text-ink">{item.label}</dt>
						<dd class="text-base text-ink-muted leading-relaxed">{item.desc}</dd>
					</div>
				))}
			</dl>

			<p class="text-small text-ink-muted mt-8 font-mono">
				No setup, no onboarding, no creative, no reporting fees. You supply product
				images and titles; we do everything else.
			</p>
		</div>
	</section>

	{/* ─── Honest fit ───────────────────────────────────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24 text-center">
			<p class="kicker mb-4">Who this works for</p>
			<p class="text-lead text-ink leading-relaxed max-w-prose mx-auto">
				This works best for Shopify brands doing roughly <span class="num text-accent">₹3–50 lakh</span> a month in net sales.
			</p>
			<p class="text-base text-ink-muted leading-relaxed mt-5 max-w-prose mx-auto">
				Below that, the ₹20,000 minimum is a big share of your sales, and we'll say so in the first conversation rather than take the account. Above it, the model still works, but a fixed retainer may suit you better and we'll tell you that too.
			</p>
		</div>
	</section>

	{/* ─── 5 · Why we publish this ─────────────────────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
			<p class="kicker mb-4">Why publish</p>
			<h2 class="text-h1 font-serif max-w-[22ch]">
				Why we publish this.
			</h2>
			<div class="mt-8 grid gap-6 md:grid-cols-3 md:gap-10">
				<p class="text-base text-ink-muted leading-relaxed">
					<span class="kicker text-ink block mb-2">One</span>
					It saves you the discovery call if the number doesn’t fit your budget.
				</p>
				<p class="text-base text-ink-muted leading-relaxed">
					<span class="kicker text-ink block mb-2">Two</span>
					It makes us defend the rate publicly instead of raising it quietly.
				</p>
				<p class="text-base text-ink-muted leading-relaxed">
					<span class="kicker text-ink block mb-2">Three</span>
					If you’re comparing us to three other agencies, having our number in
					front of you means you compare on what actually matters &mdash; the work,
					and the terms.
				</p>
			</div>
		</div>
	</section>

	{/* ─── 6 · FAQ (FAQPage schema emitted above) ──────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
			<p class="kicker mb-4">Questions</p>
			<h2 class="text-h1 font-serif max-w-[22ch]">
				Questions we get before signing.
			</h2>

			<div class="mt-12 max-w-prose border-t border-rule">
				{faqs.map((qa) => (
					<details class="group border-b border-rule py-5" open>
						<summary class="cursor-pointer list-none flex items-start gap-4">
							<span aria-hidden="true" class="kicker mt-2 text-accent num">Q</span>
							<h3 class="font-serif text-h3 font-medium text-ink flex-1">
								{qa.question}
							</h3>
						</summary>
						<p class="mt-4 pl-9 text-base text-ink-muted leading-relaxed">
							{qa.answer}
						</p>
					</details>
				))}
			</div>
		</div>
	</section>

	{/* ─── 7 · Close ────────────────────────────────────────────────── */}
	<section class="bg-paper panel my-3 md:my-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24 text-center">
			<p class="font-serif text-h2 max-w-[30ch] mx-auto">
				If <span class="num text-accent">₹20,000</span> or 4% of net sales sounds like
				it might fit, the next step is a two-line WhatsApp message.
			</p>
			<p class="text-lead text-ink-muted mt-4">
				It’s already written &mdash; just hit send.
			</p>
			<div class="mt-8 flex justify-center">
				<WhatsAppCTA message={ctaMsg} note="No forms, no sales sequence. We'll tell you honestly if the model doesn't fit your numbers." noteCentered />
			</div>
			<p class="text-small text-ink-muted mt-6">
				Only on Amazon, Flipkart or Meesho?{' '}
				<a href="/marketplaces" class="text-accent hover:text-accent-hover link-draw">
					Marketplace management is ₹20,000 + GST a month &rarr;
				</a>
			</p>
		</div>
	</section>

</BaseLayout>
