---
/**
 * TEMPORARY — Step 0 of the visual-system plan. Delete the whole
 * src/pages/type-test/ folder once the display face is chosen.
 *
 * One route per candidate so each loads at the top of the page — the
 * comparison has to be judged at real display scale, and a single scrolling
 * page made that unreliable to capture.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

import '@fontsource-variable/bodoni-moda/index.css';
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource/libre-caslon-display/400.css';

export function getStaticPaths() {
  return [
    {
      params: { face: 'bodoni' },
      props: {
        n: 1,
        name: 'Bodoni Moda',
        stack: '"Bodoni Moda Variable", Georgia, serif',
        weight: 600,
        note: 'Didone. Sharpest thick/thin contrast of the three, with an optical-size axis — drawn differently at display vs text size. Least used of the three.',
      },
    },
    {
      params: { face: 'fraunces' },
      props: {
        n: 2,
        name: 'Fraunces',
        stack: '"Fraunces Variable", Georgia, serif',
        weight: 600,
        note: 'Warmer and more characterful, with a WONK axis for expressive display settings. What the site used before Instrument Serif.',
      },
    },
    {
      params: { face: 'caslon' },
      props: {
        n: 3,
        name: 'Libre Caslon Display',
        stack: '"Libre Caslon Display", Georgia, serif',
        weight: 400,
        note: 'Closest to book typography. Traditional, familiar, least dramatic at scale.',
      },
    },
  ];
}

const { n, name, stack, weight, note } = Astro.props;
const others = [
  { slug: 'bodoni', label: 'Bodoni Moda' },
  { slug: 'fraunces', label: 'Fraunces' },
  { slug: 'caslon', label: 'Libre Caslon' },
];
const current = Astro.params.face;
---

<BaseLayout
	title={`${name} — typeface test`}
	description="Internal — display typeface comparison at real hero scale."
	noindex
>
	<div class="bg-paper panel my-4">
		<div class="px-5 md:px-10 py-8 md:py-12">

			<div class="flex items-baseline justify-between gap-4 flex-wrap border-b border-rule pb-4 mb-8">
				<div class="flex items-baseline gap-3">
					<span class="num text-h2 text-accent">{String(n).padStart(2, '0')}</span>
					<h1 class="font-sans text-h3 font-semibold">{name}</h1>
					<span class="font-mono text-micro text-ink-muted">weight {weight}</span>
				</div>
				<nav class="flex gap-4">
					{others.map((o) => (
						<a
							href={`/type-test/${o.slug}`}
							class:list={[
								'font-mono text-small underline decoration-1 underline-offset-4',
								o.slug === current ? 'text-ink' : 'text-accent hover:text-accent-hover',
							]}
						>{o.label}</a>
					))}
				</nav>
			</div>

			{/* Display scale — this is the actual decision */}
			<p
				style={`font-family: ${stack}; font-weight: ${weight}; font-size: clamp(2.75rem, 11vw, 11rem); line-height: 0.92; letter-spacing: -0.045em;`}
			>
				Stop managing five different agencies.<br />We're one team that owns your ecommerce growth.
			</p>

			{/* h1 scale */}
			<p
				class="mt-12"
				style={`font-family: ${stack}; font-weight: ${weight}; font-size: clamp(2rem, 6vw, 4.5rem); line-height: 1.02; letter-spacing: -0.03em;`}
			>
				You build the product. We build the business around it.
			</p>

			<div class="mt-12 grid gap-8 md:grid-cols-[1.1fr_1fr] md:gap-14 items-start">
				<div>
					<p
						style={`font-family: ${stack}; font-weight: ${weight}; font-size: clamp(1.5rem, 2.6vw, 2.25rem); line-height: 1.15; letter-spacing: -0.02em;`}
					>
						Most agencies tell you what they did. We'll tell you why we decided it.
					</p>
					<p class="font-sans text-base text-ink-muted leading-relaxed mt-5 max-w-[58ch]">
						Running an ecommerce business is a series of decisions, and most of them
						aren't obvious. This paragraph is the real body font at the real size —
						the pairing matters as much as the headline does.
					</p>
					<p class="font-sans text-small text-ink-muted leading-relaxed mt-6 max-w-[58ch]">{note}</p>
				</div>

				{/* Numerals — the site is full of ₹ figures */}
				<div class="bg-paper-raised border border-rule rounded-2xl p-6">
					<p class="kicker mb-3">Numerals at display scale</p>
					<p style={`font-family: ${stack}; font-weight: ${weight}; font-size: clamp(3rem, 8vw, 5rem); line-height: 1; letter-spacing: -0.03em;`}>5.1x</p>
					<p class="mt-2" style={`font-family: ${stack}; font-weight: ${weight}; font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.1;`}>₹6,70,173</p>
				</div>
			</div>

		</div>
	</div>
</BaseLayout>
