---
/**
 * /fashion: Meta and Google ad landing page for fashion and ethnic wear
 * sellers. Copy, order and design notes: docs/growth/02b (v2). Use the copy
 * exactly as written there; client numbers come only from results.json.
 *
 * Assets still to make (02b Part 2) render as labelled .lp-ph frames at the
 * final aspect ratio. Swap each for an <img> (AVIF/WebP, width/height set,
 * loading="lazy" below the fold) when the asset exists.
 */
import LandingLayout from '../layouts/LandingLayout.astro';
import results from '../data/results.json';
import { SITE } from '../lib/site';
import {
  Megaphone, Search, ShoppingBag, ChartLine, PackageX, MessageCircle,
  CircleX, CircleCheck, Store, Image, Clapperboard, MessageSquare, Camera,
  CalendarDays, PhoneCall, Check, ArrowRight, ArrowUpRight, ShieldAlert,
  Mail, Star, CircleAlert,
} from '@lucide/astro';

const CTA = 'Apne brand ke baare mein batayein';
// Public demo of the Orcas Dashboard (demo client, made-up data). Leave empty
// until the demo exists; the button only renders when this is set.
const DEMO_DASHBOARD_URL = '';
const fmt = (n: number) => '₹' + n.toLocaleString('en-IN');
const waBase = `https://wa.me/${SITE.contact.whatsapp.replace(/[^0-9]/g, '')}`;

// ── Proof (section 8): every value read from results.json ─────────────
const roas = results.headline.roas;
const divine = results.clients.find((c) => c.slug === 'divine-rudras')!;
const divineAmount = divine.result.kind === 'quantitative' ? (divine.result as { amount: number }).amount : 0;
const brandCount = results.headline.brandCount.value;

// Store order from 02b §8. Jaipur Rang is left out (no longer a client).
const storeOrder = ['savana-kurti', 'vastranama', 'khamma-ghani', 'rajvanshi-suit', 'amrit-valley', 'brinza', 'healthscot', 'pd-wellness', 'ladakh-berry'];
const stores = storeOrder
  .map((slug) => results.clients.find((c) => c.slug === slug))
  .filter((c): c is (typeof results.clients)[number] & { liveUrl: string } => Boolean(c && 'liveUrl' in c && c.liveUrl));

// ── Section 2 ─────────────────────────────────────────────────────────
const problems = [
  { now: 'Mahine ke end mein bhi pata nahi ki RTO aur returns ke baad profit hua ya loss.', fixTitle: 'Profit dashboard:', fix: 'har din, har hafte, har mahine ka P&L, RTO, shipping aur ad spend ke baad.' },
  { now: 'COD orders dispatch hote hain, aur kai wapas aa jaate hain.', fixTitle: 'RTO control:', fix: 'WhatsApp pe COD confirmation, problem wale pincodes block, prepaid ke liye nudge.' },
  { now: 'NDR wale parcels ka kisi ko pata nahi, customer ko call kisi ne nahi kiya.', fixTitle: 'NDR desk:', fix: 'har NDR parcel ki list, kisko call karna hai, re-attempt kab hai. Sab dashboard pe.' },
  { now: 'Prepaid orders kam, COD zyada.', fixTitle: 'Meta CAPI setup,', fix: 'taaki ads zyada prepaid khareedne wale customers tak pahunchein.' },
  { now: 'Ads pe paisa jaata hai, par kaun sa ad profit de raha hai, pata nahi.', fixTitle: 'Har ad ka faisla:', fix: 'Scale, Keep ya Cut, RTO aur shipping ke baad ke profit pe.' },
  { now: 'Meta wallet khatam, ads band, aur pata baad mein chalta hai.', fixTitle: 'Wallet alert:', fix: 'paisa khatam hone se pehle hi khabar.' },
  { now: 'Ads ek freelancer, photos doosra, website teesra.', fixTitle: 'Ek team, ek fee.', fix: '' },
];

// ── Section 3 ─────────────────────────────────────────────────────────
const tiles = [
  { title: 'Shopify store', body: 'Store ke roz ke changes aur fixes, fee mein included.', icon: Store },
  { title: 'AI catalogue photos', body: 'Flat-lay ya hanger photo se model shot, poore catalogue ke liye.', icon: Image },
  { title: 'AI video ads', body: 'Har mahine 10 tak, fee mein included.', icon: Clapperboard },
  { title: 'WhatsApp automation', body: 'Abandoned cart, order updates, reorder reminders, festival broadcasts.', icon: MessageSquare },
  { title: 'Instagram', body: 'Reels, captions aur posting.', icon: Camera },
  { title: 'Festive calendar', body: 'Diwali, shaadi season, Rakhi, end-of-season sale. Planning 4–6 hafte pehle, creatives ready.', icon: CalendarDays },
];

// ── Section 4 ─────────────────────────────────────────────────────────
const dashTabs = [
  { id: 'aaj', label: 'Aaj', desc: 'Aaj ke orders, sales, Meta aur Google spend, cost per order, kitne orders ship hone baaki.' },
  { id: 'pnl', label: 'P&L', desc: 'Din, hafte ya mahine ka P&L, ek click mein Excel.' },
  { id: 'ads', label: 'Ads', desc: 'Campaign se ad tak, har ad pe Scale, Keep ya Cut, asal profit ke hisaab se.' },
  { id: 'rto', label: 'RTO aur NDR', desc: 'COD vs prepaid, courier-wise RTO, risky pincodes, NDR call list.' },
  { id: 'products', label: 'Products', desc: 'Kaun sa product profit de raha hai, kaun sa nahi.' },
];

// Sample data for the "Profit by day" chart (demo store, not a client).
const profitByDay = [42, 58, 35, -18, 64, 71, 50, -9, 46, 80, 62, -24, 55, 74];
const chartW = 280, chartH = 150, zeroY = 100, scale = 1.1, gap = 6;
const barW = (chartW - gap * (profitByDay.length - 1)) / profitByDay.length;

// ── Section 6 ─────────────────────────────────────────────────────────
const kurtis = [1, 2, 3, 4];

// ── Section 7 ─────────────────────────────────────────────────────────
const included = [
  'Meta aur Google ads management',
  'Shopify store support',
  'Profit dashboard, daily aur weekly summary',
  'RTO, COD aur NDR control',
  'AI catalogue photos aur 10 tak AI video ads',
  'WhatsApp automation, Instagram, festive calendar',
  'Har hafte 15 minute ki review call',
];

// ── Section 9 ─────────────────────────────────────────────────────────
const faqs = [
  { q: 'Ads ka kharcha is fee mein shaamil hai?', a: 'Nahi. Ads ka paisa aap apne Meta aur Google account se seedha dete hain. Hamari fee alag hai.' },
  { q: '4% kis pe lagta hai?', a: 'Net sales pe, yaani returns aur RTO ke baad jo sales bachti hai. Har mahine ₹25,000 ya net sales ka 4%, jo bhi zyada ho, plus GST.' },
  { q: 'Kya aap fashion brands ke saath kaam karte hain?', a: 'Haan. Savana Kurti, Rajvanshi Suit, Vastranama aur Khamma Ghani jaise brands ke store hum sambhalte hain. Links upar diye hain.' },
  { q: 'Kaam pasand na aaye to?', a: 'Jab chahein band kar dijiye. Koi lock-in nahi, koi notice period nahi.' },
  { q: 'Ad account aur store ka access kiske paas rahega?', a: 'Aapke paas. Ads aapke apne account se chalte hain aur store bhi aapka hi rehta hai.' },
  { q: 'GST bill milega?', a: 'Haan, har mahine fee ka GST invoice milta hai.' },
];

// Bands drafted 2026-11-06; Kiran to confirm.
const spendBands = ['₹50K se kam', '₹50K–1L', '₹1–3L', '₹3L+'];
const calDays = ['Som', 'Man', 'Bud', 'Gur', 'Shu', 'Sha', 'Rav'];
---

<LandingLayout
	title="Fashion aur ethnic wear brands ke liye: ads, store, RTO aur profit dashboard | Orcas Prime"
	description="Meta ads, Shopify store, RTO control aur profit dashboard. Sab ek team ke paas. ₹25,000/mahina + GST ya net sales ka 4%, jo bhi zyada ho. Koi lock-in nahi."
	whatsappMessage="Namaste, mujhe apne fashion brand ke liye Orcas Prime ke baare mein jaanna hai."
>
	{/* ════ 1. Hero ════ */}
	<section class="lp-hero lp-print" id="hero" aria-labelledby="hero-title">
		<div class="lp-wrap lp-hero__grid">
			<div>
				<p class="lp-hero__kicker" data-hero="0">Fashion aur ethnic wear brands ke liye</p>
				<h1 id="hero-title" data-hero="0">Meta ads, Shopify store, RTO control aur profit dashboard. <em>Sab ek team ke paas.</em></h1>
				<p class="lp-hero__sub" data-hero="120">Hum aapke ads chalate hain, store sambhalte hain, RTO pe control rakhte hain, aur dashboard pe dikhate hain ki asal mein kitna profit hua.</p>
				<ul class="lp-chips" data-hero="200" aria-label="Kya kya milta hai">
					<li class="lp-chip"><Megaphone size={15} aria-hidden="true" />Meta Ads</li>
					<li class="lp-chip"><Search size={15} aria-hidden="true" />Google Ads</li>
					<li class="lp-chip"><ShoppingBag size={15} aria-hidden="true" />Shopify</li>
					<li class="lp-chip"><ChartLine size={15} aria-hidden="true" />Profit dashboard</li>
					<li class="lp-chip"><PackageX size={15} aria-hidden="true" />RTO + NDR</li>
					<li class="lp-chip"><MessageCircle size={15} aria-hidden="true" />WhatsApp</li>
				</ul>
				<div class="lp-hero__cta" data-hero="300">
					<a href="#apply" class="lp-btn lp-btn--block">{CTA}<ArrowRight size={18} class="lp-arrow" aria-hidden="true" /></a>
					<p class="lp-note">Koi lock-in nahi · Hum har mahine sirf 3 naye brands lete hain</p>
				</div>
			</div>

			{/* Phone with the dashboard's "Aaj ka hisaab" screen. Drawn in HTML
			    until the real 390 px screenshot exists (02b asset #1). */}
			<div class="lp-hero__visual" data-hero="360">
				<div class="lp-hero__device">
				<div class="lp-phone" role="img" aria-label="Orcas Dashboard ka 'Aaj ka hisaab' screen, sample data: 42 orders, cost per order ₹186, Meta wallet ₹8,400">
					<div class="lp-phone__notch"></div>
					<div class="lp-phone__screen">
						<div class="lp-dash" aria-hidden="true">
							<div class="lp-dash__head">
								<span class="lp-dash__title">Aaj ka hisaab</span>
								<span class="lp-sample">Sample data</span>
							</div>
							<div class="lp-dash__grid">
								<div class="lp-kpi"><div class="lp-kpi__label">Orders</div><div class="lp-kpi__value">42</div></div>
								<div class="lp-kpi"><div class="lp-kpi__label">Sales value</div><span class="lp-skel" style="width:80%"></span></div>
								<div class="lp-kpi"><div class="lp-kpi__label">Ad spend</div><span class="lp-skel" style="width:70%"></span></div>
								<div class="lp-kpi"><div class="lp-kpi__label">Cost per order</div><div class="lp-kpi__value">₹186</div></div>
								<div class="lp-kpi lp-kpi--wide"><div><div class="lp-kpi__label">Meta wallet</div><div class="lp-kpi__value">₹8,400</div></div><Megaphone size={18} color="#2F4739" /></div>
							</div>
							<div class="lp-dash__chart">
								<div class="lp-kpi__label">Orders, aaj</div>
								<svg viewBox="0 0 200 60" preserveAspectRatio="none">
									<polyline points="0,52 20,48 40,50 60,40 80,42 100,30 120,34 140,22 160,26 180,14 200,10" fill="none" stroke="#2F4739" stroke-width="2" vector-effect="non-scaling-stroke" />
								</svg>
							</div>
						</div>
					</div>
				</div>

				<div class="lp-float lp-float--wa" data-float="700" aria-hidden="true">
					<div class="lp-float__row"><MessageCircle size={14} />WhatsApp</div>
					Aaj: 42 orders · CPP ₹186 · Wallet ₹8,400
				</div>
				<div class="lp-float lp-float--alert" data-float="1100" aria-hidden="true">
					<div class="lp-float__row"><ShieldAlert size={14} />RTO risk</div>
					3 orders, pincode block
				</div>
				<span class="lp-sample lp-hero__tag" aria-hidden="true">Sample data</span>
				</div>
			</div>
		</div>
	</section>

	{/* ════ 3. Bento ════ */}
	<section class="lp-section lp-section--sunken" aria-labelledby="s3-title">
		<div class="lp-wrap">
			<h2 id="s3-title" class="lp-h2" data-reveal>Ek team. Poora kaam.</h2>
			<ul class="lp-bento" data-stagger="60">
				<li class="lp-tile lp-tile--wide" data-reveal>
					<h3>Meta Ads, poori management</h3>
					<p>Campaign structure, audiences, creative testing, budget pacing, Pixel aur CAPI tracking. Har hafte kya badla, uska likha hua log.</p>
					<div class="lp-tile__art" aria-hidden="true" data-adcards>
						{[['scale', 'Scale'], ['keep', 'Keep'], ['cut', 'Cut']].map(([k, label]) => (
							<div class="lp-adcard">
								<div class="lp-adcard__img"><svg viewBox="0 0 26 34"><path d="M9 1h8l1 3 6 3-2 7-3-1v20H7V13l-3 1-2-7 6-3z" fill="currentColor" /></svg></div>
								<div class="lp-adcard__line"></div>
								<div class="lp-adcard__line lp-adcard__line--s"></div>
								<span class={`lp-verdict lp-verdict--${k}`}>{label}</span>
							</div>
						))}
					</div>
				</li>
				{tiles.slice(0, 1).map((t) => (
					<li class="lp-tile" data-reveal>
						<span class="lp-tile__icon"><t.icon size={22} aria-hidden="true" /></span>
						<h3>{t.title}</h3><p>{t.body}</p>
					</li>
				))}
				{tiles.slice(1, 2).map((t) => (
					<li class="lp-tile" data-reveal>
						<span class="lp-tile__icon"><t.icon size={22} aria-hidden="true" /></span>
						<h3>{t.title}</h3><p>{t.body}</p>
					</li>
				))}
				<li class="lp-tile lp-tile--wide" data-reveal>
					<h3>Google Ads</h3>
					<p>Search, Shopping, Performance Max aur remarketing. Google Merchant Center pe aapke products ki free listings bhi.</p>
					<div class="lp-tile__art" aria-hidden="true">
						<div class="lp-gshop">
							<div class="lp-gshop__img"><svg viewBox="0 0 26 34"><path d="M9 1h8l1 3 6 3-2 7-3-1v20H7V13l-3 1-2-7 6-3z" fill="currentColor" /></svg></div>
							<div class="lp-gshop__body">
								<span class="lp-gshop__spon">Sponsored · Shopping</span>
								<div class="lp-adcard__line" style="width:90%"></div>
								<div class="lp-adcard__line lp-adcard__line--s"></div>
								<span class="lp-gshop__stars">{[1, 2, 3, 4, 5].map(() => <Star size={11} fill="currentColor" stroke-width={0} />)}</span>
							</div>
						</div>
					</div>
				</li>
				{tiles.slice(2).map((t, i) => (
					<li class={`lp-tile${i === 3 ? ' lp-tile--full' : ''}`} data-reveal>
						<span class="lp-tile__icon"><t.icon size={22} aria-hidden="true" /></span>
						<div><h3>{t.title}</h3><p>{t.body}</p></div>
					</li>
				))}
			</ul>
		</div>
	</section>

	{/* ════ 2. Before / after ════ */}
	<section class="lp-section" aria-labelledby="s2-title">
		<div class="lp-wrap">
			<h2 id="s2-title" class="lp-h2" data-reveal>Kya aapka online business aise chalta hai?</h2>
			<div class="lp-ba__heads" aria-hidden="true"><span>Abhi</span><span>Orcas Prime ke saath</span></div>
			<ul class="lp-ba">
				{problems.map((p) => (
					<li class="lp-ba__row" data-ba>
						<div class="lp-ba__cell lp-ba__now" data-ba-now>
							<CircleX size={20} aria-hidden="true" />
							<p><span class="lp-ba__tag" aria-hidden="true">Abhi</span><span class="sr-only">Abhi: </span>{p.now}</p>
						</div>
						<svg class="lp-ba__arrow" viewBox="0 0 40 12" aria-hidden="true">
							<path d="M0 6h36" stroke="currentColor" stroke-width="1.5" stroke-dasharray="40" stroke-dashoffset="0" data-ba-line />
							<path d="M31 1l6 5-6 5" fill="none" stroke="currentColor" stroke-width="1.5" />
						</svg>
						<div class="lp-ba__cell lp-ba__fix" data-ba-fix>
							<CircleCheck size={20} aria-hidden="true" />
							<p><span class="lp-ba__tag" aria-hidden="true">Orcas Prime ke saath</span><span class="sr-only">Orcas Prime ke saath: </span><strong>{p.fixTitle}</strong>{p.fix && ' ' + p.fix}</p>
						</div>
					</li>
				))}
			</ul>
			<div class="lp-mini-cta" data-reveal>
				<a href="#apply" class="lp-btn lp-btn--block">{CTA}<ArrowRight size={18} class="lp-arrow" aria-hidden="true" /></a>
			</div>
		</div>
	</section>

	{/* ════ 4. Dashboard ════ */}
	<section class="lp-section lp-section--sunken" aria-labelledby="s4-title">
		<div class="lp-wrap">
			<h2 id="s4-title" class="lp-h2" data-reveal>Aapka poora business, ek dashboard pe</h2>
			<p class="lp-lead" data-reveal>Orders, ad spend, RTO aur profit. Ek jagah, live.</p>
			{DEMO_DASHBOARD_URL && (
				<p class="lp-demo" data-reveal>
					<a class="lp-btn lp-btn--ghost" href={DEMO_DASHBOARD_URL} target="_blank" rel="noopener">Demo dashboard kholiye<ArrowUpRight size={18} aria-hidden="true" /></a>
				</p>
			)}

			<div class="lp-dashsec__grid">
				<div>
					{/* Desktop: laptop + tabs */}
					<div class="lp-dash-desktop" data-reveal>
						<div class="lp-tabs" role="tablist" aria-label="Dashboard ke screens">
							{dashTabs.map((t, i) => (
								<button class="lp-tab" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} type="button">{t.label}</button>
							))}
						</div>
						<div class="lp-laptop">
							<div class="lp-laptop__lid">
								<div class="lp-laptop__screen">
									{dashTabs.map((t, i) => (
										<div class="lp-tabpanel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0} data-panel>
											<div class="lp-ph">
												<span class="lp-ph__label"><strong>Dashboard screenshot: {t.label}</strong>Demo store, sample data<span class="lp-ph__dim">1440 × 900 · AVIF/WebP</span></span>
											</div>
										</div>
									))}
								</div>
							</div>
							<div class="lp-laptop__base"></div>
						</div>
						{dashTabs.map((t, i) => (
							<p class="lp-tabdesc" data-desc={t.id} hidden={i !== 0}><strong>{t.label}</strong> · {t.desc}</p>
						))}
					</div>

					{/* Mobile: swipeable phone screens */}
					<div class="lp-dash-mobile" data-reveal>
						<div class="lp-embla" data-embla aria-roledescription="carousel" aria-label="Dashboard ke screens">
							<div class="lp-embla__track">
								{dashTabs.map((t, i) => (
									<div class="lp-embla__slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${dashTabs.length}: ${t.label}`}>
										<div class="lp-phone">
											<div class="lp-phone__notch"></div>
											<div class="lp-phone__screen">
												<div class="lp-ph">
													<span class="lp-ph__label"><strong>Dashboard: {t.label}</strong>Demo store, sample data<span class="lp-ph__dim">390 × 844 · AVIF/WebP</span></span>
												</div>
											</div>
										</div>
										<p class="lp-embla__cap"><strong>{t.label}</strong>{t.desc}</p>
									</div>
								))}
							</div>
						</div>
						<div class="lp-dots" data-embla-dots hidden>
							{dashTabs.map((t, i) => (
								<button class="lp-dot" type="button" aria-label={`Screen ${i + 1}: ${t.label}`} aria-current={i === 0 ? 'true' : 'false'}></button>
							))}
						</div>
					</div>
				</div>

				{/* Profit by day, inline SVG, sample data */}
				<figure class="lp-chartcard" data-reveal>
					<div class="lp-chartcard__head">
						<h3>Profit by day</h3>
						<span class="lp-sample">Sample data</span>
					</div>
					<svg viewBox={`0 0 ${chartW} ${chartH}`} role="img" aria-label="Sample data: 14 din ka profit. 11 din profit mein, 3 din loss mein." data-chart>
						<line x1="0" x2={chartW} y1={zeroY} y2={zeroY} stroke="#D6CFC2" stroke-width="1" />
						{profitByDay.map((v, i) => {
							const h = Math.abs(v) * scale;
							const x = i * (barW + gap);
							return v >= 0
								? <rect class="lp-bar lp-bar--up" x={x} y={zeroY - h} width={barW} height={h} rx="3" />
								: <rect class="lp-bar lp-bar--down" x={x} y={zeroY} width={barW} height={h} rx="3" />;
						})}
					</svg>
					<figcaption class="lp-legend">
						<span><i style="background:#2F4739"></i>Profit</span>
						<span><i style="background:#B4533C"></i>Loss</span>
					</figcaption>
				</figure>
			</div>
		</div>
	</section>

	{/* ════ 5. Daily + weekly reports ════ */}
	<section class="lp-section" aria-labelledby="s5-title">
		<div class="lp-wrap">
			<h2 id="s5-title" class="lp-h2" data-reveal>Har din aur har hafte, hisaab aapke paas</h2>
			<div class="lp-reports__grid">
				<div class="lp-chatwrap" data-reveal>
					<div class="lp-phone" role="img" aria-label="WhatsApp chat, sample data: daily summary aur weekly report">
						<div class="lp-phone__notch"></div>
						<div class="lp-phone__screen">
							<div class="lp-chat" aria-hidden="true">
								<div class="lp-chat__bar">
									<span class="lp-chat__avatar">
										<svg viewBox="0 0 64 64" width="20" height="20"><rect width="64" height="64" rx="14" fill="#2F4739" /><path d="M32.5 12c1.2 6.9 4.6 14.5 10.4 21.4H26.8C28.6 26.6 30.9 19.4 32.5 12Z" fill="#FAF7F2" /></svg>
									</span>
									<span><span class="lp-chat__name">Orcas Prime</span><br /><span class="lp-chat__status">Sample data</span></span>
								</div>
								<div class="lp-chat__body" data-chat>
									<div class="lp-typing" data-typing><span></span><span></span><span></span></div>
									<div class="lp-bubble" data-chat-msg>
										<b>Daily summary</b>
										<ul>
											<li><span>Orders</span><span>42</span></li>
											<li><span>Marketing spend</span><span class="lp-skel"></span></li>
											<li><span>CPP</span><span>₹186</span></li>
											<li><span>Meta wallet</span><span>₹8,400</span></li>
										</ul>
										<span class="lp-bubble__time">9:00 pm</span>
									</div>
									<div class="lp-bubble" data-chat-msg>
										<b>Weekly report</b>
										<ul>
											<li><span>Orders</span><span class="lp-skel"></span></li>
											<li><span>Ad spend</span><span class="lp-skel"></span></li>
											<li><span>RTO</span><span class="lp-skel"></span></li>
											<li><span>Returns</span><span class="lp-skel"></span></li>
											<li><span>COD</span><span class="lp-skel"></span></li>
											<li><span>GST</span><span class="lp-skel"></span></li>
											<li class="lp-bubble__total"><span>Profit</span><span class="lp-skel"></span></li>
										</ul>
										<span class="lp-bubble__time">Som, 10:00 am</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<ul class="lp-feats" data-stagger="80">
					<li class="lp-feat" data-reveal>
						<span class="lp-feat__icon"><Mail size={22} aria-hidden="true" /></span>
						<div>
							<h3>Daily summary, WhatsApp, email aur dashboard pe</h3>
							<p>Aaj kitne orders aaye, marketing pe kitna kharch hua, cost per purchase (CPP) kitna raha, aur Meta wallet mein kitna paisa bacha.</p>
						</div>
					</li>
					<li class="lp-feat" data-reveal>
						<span class="lp-feat__icon"><MessageCircle size={22} aria-hidden="true" /></span>
						<div>
							<h3>Weekly report, WhatsApp pe</h3>
							<p>Orders, ad spend, RTO, returns, COD, GST, aur aakhir mein kitna profit bacha.</p>
						</div>
					</li>
					<li class="lp-feat" data-reveal>
						<span class="lp-feat__icon"><PhoneCall size={22} aria-hidden="true" /></span>
						<div>
							<h3>Har hafte 15 minute ki review call</h3>
							<p>Saath mein "kya badla aur kyun" ka likha hua log.</p>
							<div class="lp-cal" aria-hidden="true">
								{calDays.map((d) => <span class="lp-cal__dow">{d}</span>)}
								{Array.from({ length: 14 }, (_, i) => (
									i % 7 === 1
										? <span class="lp-cal__day lp-cal__day--call"><PhoneCall size={13} /><small>15 min</small></span>
										: <span class="lp-cal__day">{i + 1}</span>
								))}
							</div>
						</div>
					</li>
				</ul>
			</div>
		</div>
	</section>

	{/* ════ 6. AI catalogue photos ════ */}
	<section class="lp-section lp-section--sunken" aria-labelledby="s6-title">
		<div class="lp-wrap">
			<p class="lp-eyebrow" data-reveal>AI catalogue photos</p>
			<h2 id="s6-title" class="lp-h2" data-reveal>Photographer, model, studio ka kharcha nahi</h2>
			<p class="lp-lead" data-reveal>Aap product ki flat-lay ya hanger photo bhejiye. Model shot hum AI se banate hain, poore catalogue ke liye.</p>

			<div class="lp-ai__grid">
				<div data-reveal>
					<div class="lp-compare">
						<span class="lp-sample lp-compare__ai">AI se bana sample</span>
						<img-comparison-slider value="50" aria-label="Hanger photo aur AI model shot ki tulna. Handle ko left ya right le jaayein.">
							<div slot="first" class="lp-ph" data-before>
								<span class="lp-ph__label"><strong>Hanger photo · Kurti 1</strong><span class="lp-ph__dim">1200 × 1500 · AVIF/WebP</span></span>
							</div>
							<div slot="second" class="lp-ph" data-after>
								<span class="lp-ph__label"><strong>AI model shot · Kurti 1</strong><span class="lp-ph__dim">1200 × 1500 · AVIF/WebP</span></span>
							</div>
						</img-comparison-slider>
						<div class="lp-compare__tags" aria-hidden="true"><span class="lp-compare__tag">Hanger photo</span><span class="lp-compare__tag">AI model shot</span></div>
					</div>
					<ul class="lp-thumbs" aria-label="Kurti chuniye">
						{kurtis.map((k) => (
							<li>
								<button class="lp-thumb" type="button" aria-pressed={k === 1 ? 'true' : 'false'} data-kurti={k} aria-label={`Kurti ${k}`}>
									<span class="lp-ph"><span class="lp-ph__label">Kurti {k}</span></span>
								</button>
							</li>
						))}
					</ul>
				</div>

				<ul class="lp-videos" data-stagger="80">
					{[1, 2, 3].map((n) => (
						<li data-reveal>
							<div class="lp-phone">
								<div class="lp-phone__screen">
									<div class="lp-ph">
										<span class="lp-ph__label"><strong>AI video ad {n}</strong>9:16 · 10–15 s · captions<span class="lp-ph__dim">muted autoplay</span></span>
									</div>
								</div>
							</div>
							<p class="lp-videos__cap">AI se bana sample</p>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	{/* ════ 7. Fee ════ */}
	<section class="lp-section lp-print lp-fee" aria-labelledby="s7-title">
		<div class="lp-wrap lp-fee">
			<div class="lp-feecard" data-reveal>
				<h2 id="s7-title" class="sr-only">Fee</h2>
				<p class="lp-price"><span class="lp-price__amt">₹25,000</span><span class="lp-price__per">/mahina + GST</span></p>
				<p class="lp-price__or">ya net sales ka 4%, jo bhi zyada ho</p>
				<p class="lp-price__fine">Net sales matlab returns aur RTO ke baad ki sales.</p>
				<ul class="lp-incl" data-stagger="60">
					{included.map((item) => (
						<li data-reveal><Check size={18} aria-hidden="true" /><span>{item}</span></li>
					))}
				</ul>
				<div class="lp-pills">
					<span class="lp-pill"><Check size={14} aria-hidden="true" />Koi lock-in nahi</span>
					<span class="lp-pill"><Check size={14} aria-hidden="true" />Jab chahein band kar sakte hain</span>
				</div>
				<a href="#apply" class="lp-btn">{CTA}<ArrowRight size={18} class="lp-arrow" aria-hidden="true" /></a>
			</div>
		</div>
	</section>

	{/* ════ 8. Proof ════ */}
	<section class="lp-section lp-section--sunken" aria-labelledby="s8-title">
		<div class="lp-wrap">
			<h2 id="s8-title" class="lp-h2" data-reveal>Yeh brands hamare saath hain</h2>
			<ul class="lp-stats" data-stagger="80">
				<li class="lp-stat" data-reveal>
					<div class="lp-stat__num">{roas.display}</div>
					<p class="lp-stat__who">Ladakh Berry · Google Ads</p>
					<p class="lp-stat__what">{fmt(roas.spend)} ke spend pe {fmt(roas.revenue)} ki conversion value (lifetime).</p>
				</li>
				<li class="lp-stat" data-reveal>
					<div class="lp-stat__num">{fmt(divineAmount)}</div>
					<p class="lp-stat__who">Divine Rudras · Flipkart</p>
					<p class="lp-stat__what">30 din ka revenue.</p>
				</li>
				<li class="lp-stat" data-reveal>
					<div class="lp-stat__num">{brandCount} brands</div>
					<p class="lp-stat__who">Shopify aur Flipkart pe</p>
				</li>
			</ul>

			<p class="lp-stores__lead" data-reveal>Live stores, jinke saath hum kaam karte hain:</p>
			<div class="lp-stores" data-reveal>
				<ul class="lp-stores__track lp-stores__track--drift">
					{stores.map((s) => (
						<li class="lp-store">
							<a href={s.liveUrl} target="_blank" rel="noopener" aria-label={`${s.name} store (naye tab mein khulega)`}>
								<div class="lp-phone">
									<div class="lp-phone__screen">
										<div class="lp-ph"><span class="lp-ph__label"><strong>{s.name}</strong>Homepage screenshot<span class="lp-ph__dim">390 × 844</span></span></div>
									</div>
								</div>
								<span class="lp-store__name">{s.name}<ArrowUpRight size={14} aria-hidden="true" /></span>
							</a>
						</li>
					))}
					{/* Second copy for the seamless desktop drift. Hidden from AT and tab order. */}
					{stores.map((s) => (
						<li class="lp-store lp-store--dup" aria-hidden="true">
							<a href={s.liveUrl} target="_blank" rel="noopener" tabindex="-1">
								<div class="lp-phone">
									<div class="lp-phone__screen">
										<div class="lp-ph"><span class="lp-ph__label"><strong>{s.name}</strong>Homepage screenshot<span class="lp-ph__dim">390 × 844</span></span></div>
									</div>
								</div>
								<span class="lp-store__name">{s.name}<ArrowUpRight size={14} /></span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	{/* ════ 9. FAQ ════ */}
	<section class="lp-section" aria-labelledby="s9-title">
		<div class="lp-wrap">
			<h2 id="s9-title" class="lp-h2" data-reveal>Aapke sawaal</h2>
			<div class="lp-faq" data-reveal>
				{faqs.map((f) => (
					<details name="faq">
						<summary>{f.q}<span class="lp-pm" aria-hidden="true"></span></summary>
						<p class="lp-faq__a">{f.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	{/* ════ 10. Form ════ */}
	<section class="lp-section lp-formsec" id="apply" aria-labelledby="s10-title">
		<div class="lp-wrap lp-formsec__grid">
			<div>
				<h2 id="s10-title" class="lp-h2" data-reveal>Apne brand ke baare mein batayein</h2>
			</div>
			<div class="lp-formcard" data-reveal>
				{/* Leads: until the Google Sheet endpoint exists, submitting opens
				    WhatsApp with the details typed out to our number. Set
				    data-endpoint (and add its host to connect-src in vercel.json)
				    to also save each lead to the Sheet. */}
				<form id="lp-form" novalidate data-endpoint="" data-wa={waBase}>
					<div class="lp-field">
						<label for="f-name">Aapka naam</label>
						<input class="lp-input" id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="e-name" />
						<p class="lp-err" id="e-name"><CircleAlert size={14} aria-hidden="true" />Apna naam likhiye.</p>
					</div>
					<div class="lp-field">
						<label for="f-phone">WhatsApp number</label>
						<input class="lp-input" id="f-phone" name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby="e-phone" />
						<p class="lp-err" id="e-phone"><CircleAlert size={14} aria-hidden="true" />10 digit ka WhatsApp number likhiye.</p>
					</div>
					<div class="lp-field">
						<label for="f-link">Store ya Instagram link</label>
						<input class="lp-input" id="f-link" name="link" type="url" inputmode="url" autocomplete="url" autocapitalize="none" spellcheck="false" required aria-describedby="e-link" />
						<p class="lp-err" id="e-link"><CircleAlert size={14} aria-hidden="true" />Store ya Instagram ka link likhiye.</p>
					</div>
					<div class="lp-field">
						<fieldset>
							<legend>Har mahine ka ad spend</legend>
							<div class="lp-opts" id="f-spend" aria-describedby="e-spend">
								{spendBands.map((b) => (
									<label class="lp-opt"><input type="radio" name="adspend" value={b} required /><span>{b}</span></label>
								))}
							</div>
						</fieldset>
						<p class="lp-err" id="e-spend"><CircleAlert size={14} aria-hidden="true" />Ek option chuniye.</p>
					</div>
					<button class="lp-btn lp-submit" type="submit">
						<span>Application bhejiye</span>
						<ArrowRight size={18} class="lp-arrow" aria-hidden="true" />
						<span class="lp-spin" aria-hidden="true"></span>
					</button>
					<p class="lp-note">Koi lock-in nahi · Hum har mahine sirf 3 naye brands lete hain</p>
				</form>
				<div class="lp-thanks" id="lp-thanks" hidden tabindex="-1">
					<div class="lp-thanks__icon"><CircleCheck size={28} aria-hidden="true" /></div>
					<p>Shukriya. Hamari team jaldi aapke WhatsApp pe sampark karegi.</p>
					<a class="lp-thanks__wa" id="lp-thanks-wa" href={waBase} hidden>WhatsApp nahi khula? Yahan dabaiye</a>
				</div>
			</div>
		</div>
	</section>

	<div slot="after" class="lp-sticky" id="lp-sticky" data-shown="false">
		<a href="#apply" class="lp-btn" tabindex="-1">{CTA}<ArrowRight size={18} class="lp-arrow" aria-hidden="true" /></a>
	</div>
</LandingLayout>

<script>
	import 'img-comparison-slider';
	import { initLanding } from '../scripts/landing';
	initLanding();
</script>
