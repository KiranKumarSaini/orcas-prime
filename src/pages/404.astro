---
import BaseLayout from '../layouts/BaseLayout.astro';

/*
  404 (Module 6 §7).

  The site had none, so a mistyped URL, a stale link from an AI answer, or an
  old share dropped the visitor onto Vercel's default error output — no header,
  no footer, no way back, none of the brand's voice. The site is live and is
  already being linked to from search and AI answers, so this is a real exit
  path rather than a hypothetical one.

  Copy per §7: state the fact, then route. No apology paragraph, no CTA button —
  someone who landed here by accident wants a way onward, not a pitch.

  No canonicalPath is passed: a canonical tag pointing at a 404 is worse than
  none, since it invites indexing of an error page. BaseLayout falls back to
  Astro.url.pathname for the canonical, so noindex is what keeps this out of
  the index — verified in the built output.
*/

const destinations = [
  { href: '/services',   label: 'What We Own',  desc: 'The full division of labour, one item at a time.' },
  { href: '/work',       label: 'Work',         desc: 'Every Partner Brand, and what we decided.' },
  { href: '/pricing',    label: 'Pricing',      desc: '3.5% of net sales. The whole price list.' },
  { href: '/guides',     label: 'Guides',       desc: 'Straight answers, from accounts we run.' },
  { href: '/about',      label: 'About',        desc: 'Who we are and why it works this way.' },
  { href: '/how-we-work', label: 'How we work', desc: 'What the first month actually looks like.' },
];
---

<BaseLayout
	title="Page not found"
	description="That page doesn't exist. Here's what does."
	noindex
>
	<section class="bg-paper panel mt-3 md:mt-4 mb-3 md:mb-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 pt-14 md:pt-24 pb-12">
			<p class="kicker mb-4"><span class="num">404</span></p>
			<h1 class="text-display font-serif max-w-[16ch]">
				That page doesn't exist.
			</h1>
			<p class="text-lead text-ink-muted mt-6 max-w-prose leading-relaxed">
				Here's what does &mdash;
			</p>

			<ul class="mt-10 border-t border-rule max-w-prose">
				{destinations.map((d) => (
					<li class="border-b border-rule">
						<a
							href={d.href}
							class="group grid gap-1 py-5 hover:bg-accent-wash/50 -mx-4 px-4 rounded transition-colors"
						>
							<span class="font-serif text-h3 font-medium text-ink group-hover:text-accent transition-colors">
								{d.label}
							</span>
							<span class="text-base text-ink-muted leading-relaxed">{d.desc}</span>
						</a>
					</li>
				))}
			</ul>

			<p class="text-small text-ink-muted mt-10">
				<a href="/" class="text-accent hover:text-accent-hover link-draw">
					&larr; Back to the homepage
				</a>
			</p>
		</div>
	</section>
</BaseLayout>
