---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionShell from '../components/SectionShell.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Chip from '../components/Chip.astro';
import Callout from '../components/Callout.astro';
import PullQuote from '../components/PullQuote.astro';
import Accordion from '../components/Accordion.astro';
import Reveal from '../components/Reveal.astro';
import RTOFlow from '../components/RTOFlow.astro';
import VendorChain from '../components/VendorChain.astro';
import HeroConverge from '../components/HeroConverge.astro';
import PricingTable from '../components/PricingTable.astro';
import FeeCalculator from '../components/FeeCalculator.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import Schema from '../components/Schema.astro';
import { faqPage, service as serviceSchema } from '../lib/schema';
import { getCollection } from 'astro:content';
import { results, headline, fmtINR } from '../data/results';
import { SITE } from '../lib/site';

/*
  Homepage.

  Copy: docs/Module-03-Homepage-Blueprint.md, verbatim. Not one word cut,
  shortened or rephrased in the Module 9 rebuild.

  Layout: docs/Module-09-UI-Architecture.md, which supersedes Module 4's
  composition guidance. The previous build followed Module 4 literally —
  text-led, thin rules only, no visual anchors — and produced one layout
  repeated eight times, which read as a document rather than a site. Module 9
  §3 introduces surface alternation and §4 gives each section its own
  composition. Section ORDER is untouched: Module 3's psychological flow
  table still governs.

    1. Hero                  paper    full-bleed statement
    2. The Founder's Reality paper    split + card triad + pull quote
    3. The Broken System     DARK     vendor chain, RTO diagram + accordion
    4. What We Own           paper    asymmetric 4-vs-15 split
    5. How We Think          sunken   numbered decision cards
    6. Proof                 paper    display figure, cards, table
    7. Learn                 paper    card grid
    8. Start                 DARK     centred close
*/

const channels = [
	'Shopify store builds',
	'Meta & Google Ads',
	'Amazon · Flipkart · Meesho',
	'Returns & RTO handled',
];

const ctaMsg = {
	general: 'Hi, I want to check if the 3.5% model fits my store.',
	amazon: 'Hi, I want to start selling on Amazon with the free 3-month onboarding.',
};

const waDigits = SITE.contact.whatsapp.replace(/[^0-9]/g, '');
const closeCtaHref = `https://wa.me/${waDigits}?text=${encodeURIComponent(ctaMsg.general)}`;

/* ─── Section 2 — the three situations, verbatim from Module 3 §2.
   Timestamps are a visual device carrying the "all before lunch" line into
   the layout. They add no claim. */
const situations = [
	{
		stamp: '09:14',
		text: "Your Meta Ads are running, but you don't know if they're actually profitable or just generating orders that lose money after returns.",
	},
	{
		stamp: '11:40',
		text: "A shipment gets refused at the door, and now you're on the phone with the courier instead of working on your product.",
	},
	{
		stamp: 'Last month',
		text: "You changed your price last month. You're still not sure if it worked.",
	},
];

/* ─── Section 3 — the vendor chain, drawn from sub-block 1's prose. */
const vendorChain = [
	{ who: 'Ads agency',   owns: 'Optimises for orders' },
	{ who: 'Developer',    owns: "Doesn't see the ad data" },
	{ who: 'Marketplaces', owns: 'Someone else again' },
	{ who: 'Courier',      owns: 'A separate relationship' },
];

/* RTO sub-block. These four headings are the <h3>s AND the FAQPage schema
   entries — one source, so the markup can never drift from the visible text. */
const rtoPanels = [
	{
		heading: 'What RTO actually is',
		body: [
			"RTO stands for Return to Origin. It's what happens when a parcel goes out, the courier tries to deliver it, and it comes back to you undelivered — the customer refused it at the door, or wasn't reachable, or changed their mind between ordering and delivery.",
			"It's not the same as a return. A return means the customer received the product and sent it back. An RTO means they never took it at all.",
		],
	},
	{
		heading: 'Why it hurts more than it looks like it should',
		body: [
			"When an order RTOs, you don't just lose the sale. You've already paid to acquire that customer through ads. You've paid forward shipping. You pay return shipping too. The product comes back after two weeks of travel, often in no condition to sell as new. Your cash was locked up the whole time.",
			"So a 30% RTO rate doesn't reduce your profit by 30%. It can erase it entirely, while your dashboard still shows healthy order numbers.",
		],
	},
	{
		heading: "Why it's so high in India specifically",
		body: [
			'Cash on Delivery. When a customer pays nothing upfront, refusing the parcel costs them nothing. In categories like fashion, where the customer is buying on impulse and re-deciding when the courier arrives, COD orders RTO at dramatically higher rates than prepaid ones.',
		],
	},
	{
		heading: 'What actually reduces it',
		body: [
			'Address quality checks before dispatch. Choosing couriers by their real delivery rate in that specific pin code, not by their headline price. Confirming high-risk orders before they ship. Shifting the payment mix toward prepaid with incentives rather than blocking COD outright. Filing disputes on wrongly-marked deliveries instead of absorbing them.',
			'Every one of those is a decision someone has to own. Most brands have nobody owning it.',
		],
	},
];

/* Sub-block 3 — the incentive problem, as a comparison rather than prose. */
const payModels = [
	{
		model: 'A retainer',
		effect: 'Gets paid the same whether you had a good month or a terrible one.',
		ours: false,
	},
	{
		model: 'A percentage of ad spend',
		effect: 'Gets paid more when it spends more of your money — whether or not that spend converted.',
		ours: false,
	},
	{
		model: 'A percentage of net sales',
		effect: 'Gets paid only on the money that actually stayed in your account after refunds, returns and RTOs.',
		ours: true,
	},
];

/* ─── Section 4 — What We Own. */
const youKeep = ['Your product', 'Manufacturing', 'Buying inventory', 'Dispatching orders'];

/*
  The same 15 items from Module 3 §4, wording untouched, grouped into five
  clusters.

  Flat, they were 15 long phrases in a column — which is a wall of text no
  matter how it's styled, and it's what made this section read as a document.
  Chips didn't fix it either: these are sentences, not labels, so they wrapped
  into blobs. Clustering is the actual fix — a reader takes in five headings
  and can stop there, or read the detail under any one. Nothing is cut, and
  the 4-vs-15 count still holds.
*/
const weTakeClusters = [
	{
		title: 'Your store',
		items: [
			'Your Shopify store — the whole admin, day to day',
			'Branding and how the product is positioned',
			'Pricing strategy',
			'Conversion improvements on the store',
		],
	},
	{
		title: 'Advertising',
		items: [
			'Meta and Google Ads, run inside your own accounts',
			'Ad creative — graphics, video cuts, banners',
		],
	},
	{
		title: 'Marketplaces',
		items: ['Amazon, Flipkart and Meesho — listings and accounts'],
	},
	{
		title: 'Orders and logistics',
		items: [
			'RTO reduction and courier disputes',
			'Which courier to use, and where',
			'Inventory planning',
		],
	},
	{
		title: 'Growth',
		items: [
			'Product launches',
			'Scaling decisions',
			'Email and WhatsApp follow-up',
			'Analytics and reporting',
			'Overall growth strategy',
		],
	},
];

const weTakeCount = weTakeClusters.reduce((n, c) => n + c.items.length, 0);

/* ─── Section 5 — How We Think. */
const decisions = [
	{
		heading: "When we stop scaling a campaign that's still profitable",
		body: "A campaign showing good returns isn't automatically one to put more money behind. If the additional spend is bringing in customers who buy once and never return, or who order COD and refuse delivery at a higher rate, then scaling makes the top-line number look better and the bank balance worse. We look at what happens after the sale before we decide to buy more of them.",
	},
	{
		heading: 'How we choose a courier',
		body: "Not by headline rate. A courier that's ₹15 cheaper per shipment but delivers successfully 8% less often in your main states is more expensive, not less — you just pay for it in RTOs instead of on the invoice. We look at real delivery performance by region for the specific pin codes your orders actually go to.",
	},
	{
		heading: 'When we tell a brand not to spend more',
		body: "Sometimes the honest answer is that the product isn't ready, the price is wrong, or the store converts too poorly for more traffic to help. Spending more at that point is the most expensive way to find out. Because we're paid on what you keep, telling you to pause costs us money too — which is exactly why you can trust us when we say it.",
	},
];

/* ─── Schema. */
const ownershipServices = [
	serviceSchema({
		name: 'Shopify store management',
		description: 'The whole Shopify admin, day to day — products, collections, apps, theme fixes.',
		slug: 'shopify-meta-google-ads',
	}),
	serviceSchema({
		name: 'Amazon account management',
		description: 'Amazon seller account management for Indian D2C brands.',
		slug: 'amazon-account-management',
	}),
	serviceSchema({
		name: 'Flipkart and Meesho management',
		description: 'Marketplace account management on Flipkart and Meesho Seller Hub.',
		slug: 'flipkart-meesho-management',
	}),
	serviceSchema({
		name: 'Creative and catalogue',
		description: 'Product photography, ad creative, and catalogue optimisation.',
		slug: 'creative-and-catalogue',
	}),
];

const rtoFaqs = faqPage([
	{ question: 'What is RTO in ecommerce?', answer: rtoPanels[0].body.join(' ') },
	{ question: 'Why does RTO hurt more than it looks like it should?', answer: rtoPanels[1].body.join(' ') },
	{ question: 'Why is RTO so high in India specifically?', answer: rtoPanels[2].body.join(' ') },
	{ question: 'What actually reduces RTO?', answer: rtoPanels[3].body.join(' ') },
]);

/* ─── Section 6 — Proof. */
const roas = headline.roas;
const roasClient = results.clients.find((c) => c.slug === roas.clientSlug)!;

const stats = [
	{ label: 'Total tracked revenue',       value: headline.totalRevenue.display, note: 'across all Partner Brands' },
	{ label: 'Ad spend under management',   value: headline.totalAdSpend.display, note: 'across Google, Meta, Flipkart' },
	{ label: 'Brands',                      value: String(headline.brandCount.value), note: headline.brandCount.descriptor },
];

const showcase = [
	{ name: 'Ladakh Berry', url: 'https://ladakhberry.in',    img: '/work/ladakh-berry.jpg', note: 'Shopify, Google Ads, Meta Ads, creative' },
	{ name: 'Vastramahal',  url: 'https://thevastramahal.in', img: '/work/vastramahal.jpg',  note: 'Shopify, Google Ads, Meta Ads, creative' },
	{ name: 'Savana Kurti', url: 'https://savanakurti.com',   img: '/work/savana-kurti.jpg', note: 'Shopify management' },
];

/* ─── Section 7 — Learn. */
const learnSlugs = [
	'what-is-rto-and-what-does-it-cost',
	'how-to-reduce-cod-returns-india',
	'shopify-or-marketplace-first',
	'how-much-do-ecommerce-agencies-charge-in-india',
];
const allGuides = await getCollection('guides');
const learnGuides = learnSlugs
	.map((slug) => allGuides.find((g) => g.id === slug))
	.filter((g): g is NonNullable<typeof g> => Boolean(g));
---

<BaseLayout
	title="Ecommerce growth partner for Indian brands — Orcas Prime"
	description="We run your Shopify store, ads and marketplace accounts for 3.5% of net sales. No retainer. Based in Jaipur, working with Indian ecommerce brands."
	titleTemplate="none"
	canonicalPath="/"
>
<Schema slot="head" data={[rtoFaqs, ...ownershipServices]} />

	{/* ─── 1 · Hero ──────────────────────────────────────────────────── */}
	<section class="bg-paper panel mt-3 md:mt-4">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 pt-16 pb-20 md:pt-24 md:pb-28" data-animate-group>
			<h1 class="text-display font-serif max-w-[18ch]" data-animate-item style="--i:0">
				Stop managing five different agencies.<br />
				We're one team that owns your ecommerce growth.
			</h1>

			<p class="text-lead text-ink-muted mt-7 max-w-[52ch] leading-relaxed" data-animate-item style="--i:1">
				Shopify store management, Meta and Google Ads, and Amazon, Flipkart and
				Meesho — one team, one fee, tied to what you actually keep.
			</p>

			<ul class="mt-9 flex flex-wrap gap-2" data-animate-item style="--i:2">
				{channels.map((c) => <li><Chip>{c}</Chip></li>)}
			</ul>

			{/* Price line — demoted from headline position to a secondary fact
			    strip above the CTA, per Module 3 §1. */}
			<div class="mt-9 inline-flex flex-wrap items-baseline gap-x-3 gap-y-1 border-l-2 border-accent pl-5 py-1" data-animate-item style="--i:3">
				<span class="num text-h3 text-accent">3.5%</span>
				<span class="text-base text-ink">of net sales. No retainer.</span>
				<span class="text-base text-ink-muted">Nothing charged on returns or RTOs.</span>
			</div>

			<div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" data-animate-item style="--i:4">
				<WhatsAppCTA message={ctaMsg.general} />
				<a href="#what-we-own" class="font-sans text-base text-accent hover:text-accent-hover link-draw">
					See what we'd take over
				</a>
			</div>

			<div data-animate-item style="--i:5">
				<HeroConverge />
			</div>
		</div>
	</section>

	{/* ─── 2 · The Founder's Reality ──────────────────────────────────── */}
	<SectionShell width="wide" surface="raised">
		<div class="max-w-[34ch]" data-animate-item style="--i:0">
			<Eyebrow n={2} class="mb-4">Before Orcas Prime</Eyebrow>
			<h2 class="text-h1 font-serif">
				You're the founder, the marketer, the ops manager, and the person
				filing courier complaints — all before lunch.
			</h2>
		</div>

		<div class="mt-14 grid gap-5 md:grid-cols-3">
			{situations.map((s, i) => (
				<div class="card p-6 border-l-2 border-l-accent" data-animate-item style={`--i:${i + 1}`}>
					<p class="font-mono text-micro tracking-wider text-ink-muted">{s.stamp}</p>
					<p class="text-base text-ink leading-relaxed mt-3">{s.text}</p>
				</div>
			))}
		</div>

		<div data-animate-item style="--i:4">
			<PullQuote>
				None of this is because you're bad at business. It's because one person
				is doing five jobs.
			</PullQuote>
		</div>
	</SectionShell>

	{/* ─── 3 · The Broken System — dark ───────────────────────────────── */}
	<SectionShell width="reading" surface="accent">
		<div data-animate-item style="--i:0">
			<Eyebrow n={3} class="mb-4">Why it's this hard</Eyebrow>
			<h2 class="text-h1 font-serif">
				Nothing about Indian ecommerce is designed to be run by one person.
			</h2>
		</div>

		{/* Sub-block 1 — the vendor problem */}
		<div class="mt-10" data-animate-item style="--i:1">
			<VendorChain />

			<div class="mt-7">
				<Reveal label="Why none of them is at fault">
					<div class="space-y-4 text-base text-ink-muted leading-relaxed">
						<p>
							You hire an ads agency. They optimise for orders, because that's what
							they're measured on. You hire a developer for the store, but they
							don't see the ad data. Someone else handles your marketplace
							listings. Your courier is a separate relationship again.
						</p>
						<p>
							Nobody in that chain is responsible for whether your business made
							money this month. Each one did their job. The business still lost.
						</p>
					</div>
				</Reveal>
			</div>
		</div>

		<hr class="my-14" />

		{/* Sub-block 2 — RTO. The highest-value block on the site: diagram for
		    the scanner, accordion for the reader, full text in the DOM for
		    crawlers either way. */}
		<div data-animate-item style="--i:2">
			<RTOFlow />
			<Accordion items={rtoPanels} defaultOpen={0} />
			<p class="mt-6">
				<a
					href="/guides/what-is-rto-and-what-does-it-cost"
					class="font-mono text-small link-draw"
				>
					Read the full RTO guide <span class="arrow-travel">&rarr;</span>
				</a>
			</p>
		</div>

		<hr class="my-14" />

		{/* Sub-block 3 — the incentive problem */}
		<div data-animate-item style="--i:3">
			<p class="text-lead leading-relaxed opacity-90">
				Here's the part almost nobody says out loud.
			</p>

			<div class="mt-8 grid gap-3">
				{payModels.map((m) => (
					<div
						class:list={[
							'border rounded p-5 grid gap-2 sm:grid-cols-[13rem_1fr] sm:gap-6 sm:items-baseline',
							m.ours ? 'border-accent bg-paper-raised' : 'border-rule-strong bg-paper/60',
						]}
					>
						<p class:list={['font-sans text-small', m.ours ? 'text-accent font-medium' : 'text-ink']}>
							{m.model}
							{m.ours && <span class="font-mono text-micro tracking-wider ml-2 opacity-80">OURS</span>}
						</p>
						<p class="text-base leading-relaxed opacity-85">{m.effect}</p>
					</div>
				))}
			</div>

			<p class="text-lead text-ink leading-relaxed mt-8">
				The question worth asking about any agency isn't "are they good?"
				It's "what does their pricing pay them to do?"
			</p>
			<div class="mt-5">
				<Reveal label="Nobody here is doing anything wrong">
					<p class="text-base text-ink-muted leading-relaxed">
						Neither of them is doing anything wrong. They're doing exactly what
						their pricing model rewards.
					</p>
				</Reveal>
			</div>
		</div>

		<div data-animate-item style="--i:4">
			<PullQuote>
				We built Orcas Prime around a different answer to that question.
			</PullQuote>
		</div>
	</SectionShell>

	{/* ─── 4 · What We Own ────────────────────────────────────────────── */}
	<SectionShell width="wide" id="what-we-own">
		<div data-animate-item style="--i:0">
			<Eyebrow n={4} class="mb-4">What we own</Eyebrow>
			<h2 class="text-h1 font-serif max-w-[22ch]">
				You build the product. We build the business around it.
			</h2>
			<p class="text-lead text-ink-muted mt-6 max-w-[54ch]">
				Here's the actual division of labour — not a services list, a
				responsibility list.
			</p>
		</div>

		{/* The asymmetry IS the message — 4 against 15, legible before a word is
		    read (Module 3 §4). Rendered as chips rather than list rows: as rows
		    with hairline dividers this was a table of contents, and the whole
		    point — the difference in MASS between the two sides — was invisible
		    because both columns just looked like text. */}
		<div class="mt-14 grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1.9fr)] md:gap-12 items-start">
			<div class="bg-paper-raised border border-rule rounded-2xl p-6 md:p-7" data-animate-item style="--i:1">
				<div class="flex items-baseline gap-3">
					<span class="num text-h1 text-ink-muted leading-none">4</span>
					<span class="kicker">things stay<br />with you</span>
				</div>
				<ul class="flex flex-wrap gap-2 mt-6">
					{youKeep.map((item) => (
						<li><span class="chip-keep">{item}</span></li>
					))}
				</ul>
			</div>

			<div data-animate-item style="--i:2">
				<div class="flex items-baseline gap-3 mb-5 pl-1">
					<span class="num text-h1 text-accent leading-none">{weTakeCount}</span>
					<span class="kicker text-accent">become ours</span>
				</div>

				<div class="grid gap-3 grid-cols-1 sm:grid-cols-2">
					{weTakeClusters.map((cluster) => (
						<div class="bg-paper-raised border border-accent/20 rounded-2xl p-5">
							<p class="kicker text-accent mb-3">{cluster.title}</p>
							<ul class="space-y-2.5">
								{cluster.items.map((item) => (
									<li class="grid grid-cols-[0.5rem_1fr] gap-2.5 items-baseline">
										<span aria-hidden="true" class="w-1.5 h-1.5 rounded-full bg-accent/45 translate-y-[-0.15rem]"></span>
										<span class="text-small text-ink leading-snug">{item}</span>
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</div>
		</div>

		<p class="text-lead text-ink mt-12 max-w-[52ch]" data-animate-item style="--i:3">
			Four things stay with you. Everything between "the product exists" and
			"the customer has it" is ours.
		</p>

		<div class="mt-8" data-animate-item style="--i:4">
			<Callout>
				<p class="text-base text-ink leading-relaxed max-w-[58ch]">
					We run your ads inside your own ad accounts, not ours. You keep the
					data, the history and the access. We never mark up your ad spend —
					you pay Meta and Google directly, exactly what they charge.
				</p>
			</Callout>
		</div>

		<div data-animate-item style="--i:5">
			<PullQuote>
				Taking this much responsibility only works if we think about your
				business as carefully as you do. So here's how we think.
			</PullQuote>
		</div>
	</SectionShell>

	{/* Sticky mobile CTA arms here — after Section 4, per Module 8 §3.
	    Trust is earned before the ask (LOCKED#24). */}
	<div id="sv-sticky-trigger" aria-hidden="true"></div>

	{/* ─── 5 · How We Think ───────────────────────────────────────────── */}
	<SectionShell width="wide" surface="sunken">
		<div data-animate-item style="--i:0">
			<Eyebrow n={5} class="mb-4">How we think</Eyebrow>
			<h2 class="text-h1 font-serif max-w-[26ch]">
				Most agencies tell you what they did. We'll tell you why we decided it.
			</h2>
			<p class="text-lead text-ink-muted mt-6 max-w-[58ch]">
				Running an ecommerce business is a series of decisions, and most of
				them aren't obvious. Here's how we approach a few of the ones that come
				up most often.
			</p>
		</div>

		<div class="mt-12 bg-paper-raised border border-rule rounded-2xl px-6 md:px-7" data-animate-item style="--i:1">
			<Accordion
				items={decisions.map((d) => ({ heading: d.heading, body: [d.body] }))}
				defaultOpen={0}
			/>
		</div>

		<div data-animate-item style="--i:4">
			<PullQuote>
				That last one is only credible because of how we're paid. Here's what
				that looks like in practice.
			</PullQuote>
		</div>
	</SectionShell>

	{/* ─── 6 · Proof ──────────────────────────────────────────────────── */}
	<SectionShell width="wide" surface="raised">
		<div data-animate-item style="--i:0">
			<Eyebrow n={6} class="mb-4">Proof</Eyebrow>
			<h2 class="text-h1 font-serif max-w-[24ch]">
				Every number below is from an account we're running right now.
			</h2>
			<p class="text-lead text-ink-muted mt-6 max-w-[52ch]">
				Not stale case studies from three years ago. Live accounts, current
				numbers.
			</p>
		</div>

		{/* Block A — the display figure. The page's visual peak after the hero
		    (Module 9 §4). Appears at full value; never counts up. */}
		<div class="mt-16 grid gap-8 md:grid-cols-[auto_1fr] md:gap-16 md:items-center" data-animate-item style="--i:1">
			<p
				class="num text-accent leading-none"
				style="font-size: clamp(5rem, 15vw, 9rem); letter-spacing: -0.04em;"
			>{roas.display}</p>

			<div class="max-w-[42ch]">
				<p class="kicker mb-3">
					Return on ad spend · {roasClient.name} · Google Ads · {roas.period}
				</p>
				<p class="text-lead text-ink leading-relaxed">
					For every <span class="num">₹1</span> spent on ads,
					<span class="num">₹5.10</span> came back in tracked sales.
				</p>
				<dl class="mt-7 pt-6 border-t border-rule grid grid-cols-2 gap-x-8 gap-y-2.5 text-small">
					<dt class="text-ink-muted">Revenue</dt>
					<dd class="num text-ink text-right">{fmtINR(roas.revenue)}</dd>
					<dt class="text-ink-muted">Ad spend</dt>
					<dd class="num text-ink text-right">{fmtINR(roas.spend)}</dd>
					<dt class="text-ink-muted">Platform</dt>
					<dd class="text-ink text-right">{roas.platform}</dd>
				</dl>
			</div>
		</div>

		{/* Block B — aggregate */}
		<dl class="mt-12 grid gap-3 grid-cols-3">
			{stats.map((s, i) => (
				<div class="card p-4 md:p-6" data-animate-item style={`--i:${i + 2}`}>
					<dd>
						<span class="num text-ink block" style="font-size: clamp(1.25rem, 5vw, 2.25rem); line-height: 1.05;">
							{s.value}
						</span>
					</dd>
					<dt class="kicker mt-2.5 leading-snug">{s.label}</dt>
				</div>
			))}
		</dl>

		{/* Block C — Partner Brands */}
		<div class="mt-20" data-animate-item style="--i:5">
			<Eyebrow class="mb-6">Partner Brands we run</Eyebrow>
			<div class="grid gap-3 grid-cols-1 sm:grid-cols-3">
				{showcase.map((s) => (
					<a href={s.url} rel="noopener" class="card group overflow-hidden block">
						<div class="hidden md:flex items-center gap-1.5 px-3 py-2 border-b border-rule">
							<span class="w-2 h-2 rounded-full bg-rule-strong"></span>
							<span class="w-2 h-2 rounded-full bg-rule-strong"></span>
							<span class="w-2 h-2 rounded-full bg-rule-strong"></span>
							<span class="ml-3 font-mono text-micro text-ink-muted truncate">
								{s.url.replace(/^https?:\/\//, '')}
							</span>
						</div>
						<img
							src={s.img}
							alt={`${s.name} storefront`}
							width="1200" height="900" loading="lazy" decoding="async"
							class="w-full h-28 sm:h-32 md:h-36 object-cover object-top block border-b border-rule"
						/>
						<div class="p-3 md:p-4">
							<h3 class="font-serif text-h3 text-ink leading-tight">{s.name}</h3>
							<span class="font-mono text-micro text-accent mt-1.5 inline-block">
								Visit <span class="arrow-travel">&rarr;</span>
							</span>
						</div>
					</a>
				))}
			</div>
			<p class="mt-8">
				<a href="/work" class="font-sans text-base text-accent hover:text-accent-hover link-draw">
					See every case study &rarr;
				</a>
			</p>
		</div>

		{/* Block D — the pricing proof */}
		<div class="mt-20 pt-16 border-t border-rule" data-animate-item style="--i:6">
			<Eyebrow class="mb-4">Why our fee works the way it does</Eyebrow>
			<p class="max-w-[54ch] text-lead text-ink leading-relaxed">
				We charge <span class="num text-accent">3.5%</span> of net sales — the
				money left after refunds, returns and RTOs come out. The money that
				actually stayed in your account. Not orders placed.
			</p>
			<div class="mt-5">
				<Reveal label="How that differs from a retainer">
					<p class="text-base text-ink-muted leading-relaxed max-w-[54ch]">
						A retainer bills you the same whether you made money last month or
						lost it. A percentage of ad spend bills you more the more it spends,
						whether or not that spend worked.
					</p>
				</Reveal>
			</div>

			{/* The calculator is the argument made checkable — drag your own
			    number and the claim proves itself (Module 10 §4, Moment 3). */}
			<div class="mt-10">
				<FeeCalculator default={1200000} />
				<p class="text-small text-ink-muted mt-5 leading-relaxed max-w-[52ch]">
					When a shipment gets refused, we absorb that alongside you. No setup
					fee, no onboarding fee, no creative fee, no reporting fee.
				</p>
				<div class="mt-7 flex flex-wrap items-center gap-x-8 gap-y-3">
					<WhatsAppCTA message={ctaMsg.general} />
					<a href="/pricing" class="text-small text-ink-muted hover:text-accent font-mono">
						See the full price list &rarr;
					</a>
				</div>
			</div>
		</div>

		{/* Block E — honest fit */}
		<div class="mt-20 pt-16 border-t border-rule" data-animate-item style="--i:7">
			<Callout class="max-w-[62ch]">
				<Eyebrow class="mb-3">Who this works for</Eyebrow>
				<p class="text-lead text-ink leading-relaxed">
					This works best for brands doing roughly
					<span class="num text-accent"> ₹3–50 lakh</span> a month in net sales,
					on Shopify, on marketplaces, or both.
				</p>
				<p class="text-base text-ink-muted leading-relaxed mt-4">
					Below that, a percentage of your sales won't fund the work properly —
					and we'll say so in the first conversation rather than take the
					account. Above it, the model still works, but a fixed retainer may
					suit you better and we'll tell you that too.
				</p>
			</Callout>
		</div>

		<div data-animate-item style="--i:8">
			<PullQuote>
				If you're not selling online yet, there's a way to start that costs you
				nothing.
			</PullQuote>
		</div>
	</SectionShell>

	{/* ─── 7 · Learn ──────────────────────────────────────────────────── */}
	<SectionShell width="wide">
		<div data-animate-item style="--i:0">
			<Eyebrow n={7} class="mb-4">Learn</Eyebrow>
			<h2 class="text-h1 font-serif">Everything we know, written down.</h2>
			<p class="text-lead text-ink-muted mt-6 max-w-[54ch]">
				No email required, no gated PDFs. If it would help you run your
				business better, it should just be readable.
			</p>
		</div>

		<div class="mt-12 grid gap-4 grid-cols-1 sm:grid-cols-2">
			{learnGuides.map((guide, i) => (
				<a
					href={`/guides/${guide.id}`}
					class="card group p-7 block"
					data-animate-item
					style={`--i:${i + 1}`}
				>
					<p class="kicker">{guide.data.category}</p>
					<h3 class="font-serif text-h3 mt-3 group-hover:text-accent transition-colors">
						{guide.data.shortTitle}
					</h3>
					<span class="inline-block mt-4 font-mono text-small text-accent">
						Read <span class="arrow-travel">&rarr;</span>
					</span>
				</a>
			))}
		</div>

		<p class="text-small text-ink-muted mt-10 font-mono" data-animate-item style="--i:5">
			More going up as we write them.
		</p>
	</SectionShell>

	{/* ─── 8 · Start — dark close ─────────────────────────────────────── */}
	<SectionShell width="narrow" surface="accent" class="text-center">
		<h2 class="font-serif text-h1 max-w-[24ch] mx-auto" data-animate-item style="--i:0">
			If any of this made sense, the next step is a two-line WhatsApp message.
		</h2>
		<p class="text-lead mt-6 opacity-80" data-animate-item style="--i:1">
			It's already written — just hit send. We'll look at your store and your
			numbers and tell you honestly whether the model fits.
		</p>

		{/* On dark, the primary CTA inverts to paper-on-ink for maximum contrast —
		    the accent green would recede here. */}
		<div class="mt-10 flex justify-center" data-animate-item style="--i:2">
			<a
				href={closeCtaHref}
				rel="noopener"
				data-cta="whatsapp"
				class="inline-flex items-center gap-2 bg-accent text-paper hover:bg-accent-hover px-7 py-4 rounded-md font-sans text-base font-medium transition-colors"
			>
				Start on WhatsApp
				<span aria-hidden="true" class="num">&rarr;</span>
			</a>
		</div>

		<p class="text-small opacity-65 mt-5" data-animate-item style="--i:3">
			No forms, no discovery call booking, no sales sequence. A conversation.
		</p>

		{/* The wedge offer — a distinct alternative path, not a second pitch. */}
		<div
			class="mt-16 border border-rule-strong bg-paper-raised rounded-2xl p-8 text-left"
			data-animate-item
			style="--i:4"
		>
			<h3 class="font-serif text-h3">Not selling online yet? Start on Amazon for free.</h3>
			<p class="text-base opacity-80 leading-relaxed mt-4">
				We'll open your Amazon seller account, list your first products, and
				run it for three months at no cost to you. Amazon pays us a referral
				commission for bringing new sellers on — that's how it works, and
				that's why it's free. There's no lock-in after month three.
			</p>
			<div class="mt-7 flex flex-wrap items-center gap-x-8 gap-y-3">
				<a
					href={`https://wa.me/${waDigits}?text=${encodeURIComponent(ctaMsg.amazon)}`}
					rel="noopener"
					data-cta="whatsapp"
					class="inline-flex items-center gap-2 border border-ink text-ink hover:bg-ink hover:text-paper px-5 py-3 rounded-md font-sans text-base font-medium transition-colors"
				>
					Start free on WhatsApp
					<span aria-hidden="true" class="num">&rarr;</span>
				</a>
				<a href="/amazon-free-onboarding" class="text-small font-mono link-draw">
					How the 3 months works <span class="arrow-travel">&rarr;</span>
				</a>
			</div>
		</div>
	</SectionShell>

	<StickyMobileCTA message={ctaMsg.general} />

</BaseLayout>
