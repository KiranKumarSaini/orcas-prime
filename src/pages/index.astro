---
import '../styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Orcas Prime — scaffold OK</title>
	</head>
	<body>
		<main style="max-width: 44rem; margin: 4rem auto; padding: 0 1.5rem;">
			<p style="font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-muted); margin-bottom: 1.5rem;">
				Scaffold verified · Prompt 2 complete
			</p>
			<h1 style="font-family: var(--font-serif); font-weight: 500; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.05; letter-spacing: -0.02em; margin: 0 0 1.5rem;">
				No retainer. No monthly fee.<br />
				We take <span style="color: var(--color-ochre); font-feature-settings: 'tnum';">3.5%</span> of what your customers actually keep.
			</h1>
			<p style="color: var(--color-ink-muted); font-size: 1.125rem; line-height: 1.6; margin: 0 0 2.5rem;">
				This placeholder confirms the Astro + Tailwind + Fontsource + sitemap scaffold is running.
				Design tokens, layouts, and real pages come in the next prompts.
			</p>
			<hr style="border: none; border-top: 1px solid var(--color-rule); margin: 2rem 0;" />
			<dl style="font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-ink-muted); display: grid; grid-template-columns: max-content 1fr; gap: 0.5rem 1.5rem;">
				<dt>framework</dt><dd style="color: var(--color-ink);">Astro (strict TS)</dd>
				<dt>styling</dt><dd style="color: var(--color-ink);">Tailwind v4 + design tokens</dd>
				<dt>fonts</dt><dd style="color: var(--color-ink);">Fraunces · Geist Sans · Geist Mono</dd>
				<dt>collections</dt><dd style="color: var(--color-ink);">guides · work</dd>
				<dt>sitemap</dt><dd style="color: var(--color-ink);">@astrojs/sitemap wired</dd>
			</dl>
		</main>
	</body>
</html>
