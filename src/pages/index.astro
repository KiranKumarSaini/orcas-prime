---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Ecommerce agency in Jaipur — no retainer, 3.5% of what your customers keep"
	description="Shopify stores built, launched and scaled — plus Amazon, Flipkart and Meesho. We take 3.5% of net sales after returns. No retainer, no lock-in."
	titleTemplate="none"
>
	<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
		<p class="kicker mb-6">Scaffold verified · Prompt 4 complete</p>
		<h1 class="text-display font-serif font-medium">
			No retainer. No monthly fee.<br />
			We take <span class="num text-ochre">3.5%</span> of what your customers actually keep.
		</h1>
		<p class="text-lead text-ink-muted mt-6 max-w-prose">
			Shopify stores built, launched and scaled — plus Amazon, Flipkart and Meesho.
			Nothing charged on returns or RTOs.
		</p>
		<p class="text-small text-ink-muted mt-10 font-mono">
			This placeholder holds the /  route until Prompt 7 builds the real homepage.
			The BaseLayout, SiteHeader, and SiteFooter you see wrapping this content
			are the deliverables from Prompt 4.
		</p>
	</div>
</BaseLayout>
