---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import Schema from '../../components/Schema.astro';
import { breadcrumb } from '../../lib/schema';
import { fmtINR, getClients } from '../../data/results';
import { getCollection } from 'astro:content';

/*
  /work — the hub. §8 framing: results, not aesthetics.

  Every client from results.json shows up here. Clients that also have a
  case study in src/content/work render a "Read case study →" link.
  Everyone else gets an honest short card built from the qualitative
  status in §5 — no invented numbers.
*/

const clients = getClients();
const caseStudies = await getCollection('work');
const studyMap = new Map(caseStudies.map((c) => [c.data.slug, c]));

/*
  §8's three-store showcase. Screenshots are real, captured from the live
  sites by scripts/capture-stores.mjs — re-run it to refresh them.

  Note: the domain is savanakurti.com, not thesavanakurti.com — the "the"
  variant has no DNS record and was pointing at a dead link until corrected.
*/
const showcase = [
  { slug: 'ladakh-berry', img: '/work/ladakh-berry.jpg' },
  { slug: 'vastramahal',  img: '/work/vastramahal.jpg' },
  { slug: 'savana-kurti', img: '/work/savana-kurti.jpg' },
]
  .map((s) => {
    const client = clients.find((c) => c.slug === s.slug);
    return client ? { ...s, client } : null;
  })
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const ctaMsg = 'Hi, I want to check if the 3.5% model fits my store.';
---

<BaseLayout
	title="Work"
	description="Every Partner Brand we've worked with, and what we decided. Live accounts, current numbers — Ladakh Berry at 5.1x on Google Ads, Divine Rudras on Flipkart Gold tier, six more across Shopify and Flipkart."
	canonicalPath="/work"
>
	<Schema
		slot="head"
		data={breadcrumb([
			{ name: 'Home', path: '/' },
			{ name: 'Work', path: '/work' },
		])}
	/>

	{/* ─── 1 · Hero framing (Module 6 §8) ───────────────────────────── */}
	<section>
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 pt-14 md:pt-24 pb-12">
			<p class="kicker mb-4">Work</p>
			<h1 class="text-display font-serif max-w-[24ch]">
				Every brand we've worked with, and what we decided.
			</h1>
			<p class="text-lead text-ink-muted mt-6 max-w-prose leading-relaxed">
				Reporting, not a highlight reel — including what's still in progress. Every
				number below is from an account we're running right now.
			</p>
		</div>
	</section>

	{/* ─── 2 · Store showcase — real screenshots of live stores ────── */}
	<section class="border-t border-rule bg-accent-wash/40">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
			<p class="kicker mb-4">Live storefronts</p>
			<h2 class="text-h1 font-serif max-w-[24ch]">
				Stores we built, running now.
			</h2>
			<p class="text-lead text-ink-muted mt-6 max-w-prose">
				Same team, deliberately unlike each other. Click through and buy something
				&mdash; these are trading stores, not mockups.
			</p>

			<div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{showcase.map(({ client, img }) => (
					<article class="bg-paper border border-rule rounded overflow-hidden">
						<div class="flex items-center gap-1.5 px-3 py-2 border-b border-rule">
							<span class="w-2 h-2 rounded-full bg-rule-strong"></span>
							<span class="w-2 h-2 rounded-full bg-rule-strong"></span>
							<span class="w-2 h-2 rounded-full bg-rule-strong"></span>
							<span class="ml-3 font-mono text-micro text-ink-muted truncate">
								{client.liveUrl?.replace(/^https?:\/\//, '')}
							</span>
						</div>
						<img
							src={img}
							alt={`${client.name} storefront`}
							width="1200"
							height="900"
							loading="lazy"
							decoding="async"
							class="w-full h-auto block border-b border-rule"
						/>
						<div class="p-5">
							<h3 class="font-serif text-h3 font-medium text-ink">{client.name}</h3>
							<p class="font-mono text-micro text-ink-muted mt-1">
								{client.services.join(' · ')}
							</p>
							{client.liveUrl && (
								<a
									href={client.liveUrl}
									rel="noopener"
									class="mt-3 inline-block font-sans text-small text-accent hover:text-accent-hover underline decoration-1 underline-offset-4"
								>
									Visit {client.liveUrl.replace(/^https?:\/\//, '')} &rarr;
								</a>
							)}
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	{/* ─── 3 · All 8 clients — with case-study links where available ── */}
	<section class="border-t border-rule">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24">
			<p class="kicker mb-4">All Partner Brands</p>
			<h2 class="text-h1 font-serif max-w-[24ch]">
				Every account we run right now.
			</h2>

			<ul class="mt-12 border-t border-rule">
				{clients.map((client) => {
					const study = studyMap.get(client.slug);
					return (
						<li class="border-b border-rule">
							<div class="grid md:grid-cols-[1fr_2fr_auto] gap-3 md:gap-8 py-6 md:py-8 items-baseline">
								<div>
									<h3 class="font-serif text-h3 font-medium text-ink">{client.name}</h3>
									<p class="font-mono text-micro text-ink-muted mt-1">
										{client.services.join(' · ')}
									</p>
								</div>
								<div class="text-base text-ink-muted leading-relaxed">
									{client.result.kind === 'quantitative' ? (
										<span>
											<span class="num text-accent text-lead">{fmtINR(client.result.amount)}</span>
											<span> {client.result.metric}, {client.result.period}</span>
										</span>
									) : (
										<span>{client.result.description}</span>
									)}
								</div>
								<div class="md:text-right">
									{study ? (
										<a
											href={`/work/${client.slug}`}
											class="font-sans text-small text-accent hover:text-accent-hover underline decoration-1 underline-offset-4 whitespace-nowrap"
										>
											Read case study &rarr;
										</a>
									) : (
										<span class="font-mono text-micro text-ink-muted whitespace-nowrap">
											Case study soon
										</span>
									)}
								</div>
							</div>
						</li>
					);
				})}
			</ul>
		</div>
	</section>

	{/* ─── 4 · Close ────────────────────────────────────────────────── */}
	<section class="border-t border-rule">
		<div class="max-w-[76rem] mx-auto px-6 md:px-10 py-16 md:py-24 text-center">
			<p class="font-serif text-h2 max-w-[28ch] mx-auto">
				If any of this looks like the kind of work you want us doing for you &mdash;
			</p>
			<p class="text-lead text-ink-muted mt-4">
				the next step is one WhatsApp message.
			</p>
			<div class="mt-8 flex justify-center">
				<WhatsAppCTA message={ctaMsg} />
			</div>
		</div>
	</section>

</BaseLayout>
